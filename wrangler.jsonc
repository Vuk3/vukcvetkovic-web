{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "vukcvetkovic-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// This file is the input, not what ships. At build time the adapter writes
	// dist/client/wrangler.json with the directory relative to itself and points
	// wrangler at it, so the path here only matters if wrangler is invoked
	// directly. dist/client is where the site actually lands, next to the
	// _headers and .assetsignore the adapter injects.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Without this the build is pure static assets with no Worker behind
		// them, so an unmatched path returned a bodiless 404 and src/pages/404
		// would never have been reached. "404-page" serves the *nearest*
		// 404.html walking up from the requested path, which is also what makes
		// the per-locale pages worth having: /de/typo resolves to /de/404.html
		// and only falls back to the root one outside a locale prefix.
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}