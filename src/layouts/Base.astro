---
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Nav from '../components/Nav.astro';
import { locales, ogLocales, type Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { ogImageFor } from '../og/paths';
import { site } from '../site';
import '../styles/global.css';
/*
 * The Latin face of Archivo, the one every page's first screen is set in, as a
 * URL so it can be preloaded. `?url` goes through the same asset pipeline as
 * the `@font-face` in the fontsource stylesheet, so it is the same hashed file
 * and the preload is a hit rather than a second download. See the preload
 * below.
 */
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  lang: Lang;
  /** Overrides the locale's default title — for future pages such as a blog. */
  title?: string;
  description?: string;
  /**
   * Keeps the page out of search results, and with it the canonical link and
   * the hreflang set: those describe a page worth indexing in four languages,
   * which a 404 is not.
   */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const dict = getDict(lang);

const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;

// `Astro.site` is set in astro.config.ts; the fallback only satisfies types.
const siteUrl = Astro.site ?? new URL(site.url);

const canonical = new URL(localizePath(Astro.url.pathname, lang), siteUrl);

/*
 * A project, a game or one of their indexes shares a card of its own, drawn
 * at build in its language (src/og/); every other page shares the site's
 * card, the portrait. Its alt is then the page's title, which is what the
 * card sets large.
 */
const pageCard = ogImageFor(lang, Astro.url.pathname);
const ogImage = new URL(pageCard ?? site.ogImage, siteUrl);
const ogImageAlt = pageCard ? pageTitle : dict.meta.ogImageAlt;

const alternates = locales.map((locale) => ({
  hreflang: locale,
  href: new URL(localizePath(Astro.url.pathname, locale), siteUrl).href,
}));
const xDefault = new URL(localizePath(Astro.url.pathname, 'en'), siteUrl).href;

/*
 * Person and WebSite, on the four home pages only. The person is what a home
 * page is about, and repeating the entity on a project page describes nothing
 * the project page is.
 *
 * Derived from the path rather than taken as a prop, because the English route
 * and its `[lang]` twin would otherwise have to remember to agree - which is
 * the drift src/CLAUDE.md warns about. `canonical` is built the same way.
 */
const isHome = canonical.pathname === localizePath('/', lang);

/*
 * Every value comes from site.ts or the dictionary, so nothing here is a second
 * copy: change the email or the job in one place and this changes with it. That
 * matters more than usual because a wrong `sameAs` does not merely fail to
 * help, it tells Google the site belongs to somebody else's account.
 *
 * The `@id`s are absolute and identical on all four home pages, so the four
 * emit one shared entity rather than four competing ones. For the same reason
 * `inLanguage` lists every locale instead of naming the current page's.
 */
const currentRole = site.experience.find((role) => role.current);
const personId = `${siteUrl.origin}/#person`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: `${siteUrl.origin}/`,
      email: site.email,
      // The title held at `worksFor`, not the hero's headline, since the two are read as a pair.
      ...(currentRole && {
        jobTitle: dict.experience.roles[currentRole.id].role,
        worksFor: { '@type': 'Organization', name: currentRole.company },
      }),
      sameAs: [site.links.linkedin, site.links.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.origin}/#website`,
      name: site.name,
      url: `${siteUrl.origin}/`,
      inLanguage: [...locales],
      publisher: { '@id': personId },
    },
  ],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      The colour of the browser's own bar, on a phone and in Safari. These match
      --site-bg: the header is a capsule floating on the page with the ground
      showing round it, so the bar sits directly above the ground, not above
      ink. Matching the panel would put a dark strip over the light gap the
      capsule floats in.

      ⚠️ They duplicate the token in both themes and have to be changed with it.
      By their media queries they follow the system's theme. A theme chosen with
      the toggle overrides that: the script below and ThemeToggle.astro set the
      chosen tag's media to `all` and the other's to `not all`, so the bar
      follows the page and not the phone. They are above the script because it
      has to find them, and it runs before anything after it is parsed.
    */}
    <meta name="theme-color" content="#edeff3" media="(prefers-color-scheme: light)" data-scheme="light" />
    <meta name="theme-color" content="#080b12" media="(prefers-color-scheme: dark)" data-scheme="dark" />

    {/* Must run before first paint, and must not be bundled, or it flashes. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark =
            stored === 'dark' ||
            (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
          if (stored !== null) {
            for (const meta of document.querySelectorAll('meta[data-scheme]')) {
              meta.media = meta.dataset.scheme === stored ? 'all' : 'not all';
            }
          }
        } catch {
          /* Storage unavailable (private mode); fall through to light. */
        }
      })();
    </script>

    {/*
      The Latin face, fetched with the document rather than after the
      stylesheet is parsed. Without it the text painted in the fallback face
      and reflowed when Archivo arrived, which Lighthouse measured as a layout
      shift on the project pages' meta tiles. Latin only: latin-ext carries a
      handful of letters (the ć in the name among them) and 85 KB more, and
      preloading both put two fonts ahead of the portrait on a slow phone.
    */}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />

    {/* `follow` rather than `nofollow`: the page is not worth indexing, but the
        link out of it to the homepage is still worth crawling. */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {!noindex && <link rel="canonical" href={canonical.href} />}

    {
      !noindex && (
        <>
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      locales
        .filter((locale) => locale !== lang)
        .map((locale) => <meta property="og:locale:alternate" content={ogLocales[locale]} />)
    }
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* `is:inline` and `set:html` so the JSON is emitted verbatim: Astro must
        neither bundle the block nor escape the quotes inside it. */}
    {
      isHome && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }

    {/*
      Vuk's own V mark, cropped in tight from the master in src/assets. The 32px
      file is the one a browser tab actually uses, resized ahead of time rather
      than left to the browser to squeeze down from 512 - that downscale is what
      makes a large favicon look soft in the tab strip.

      The petrol SVG that used to sit here is gone. Two icons in two different
      designs would show up as two different marks depending on the browser.
    */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-site focus:border focus:border-hairline focus:bg-card focus:px-3 focus:py-2 focus:text-fg"
    >
      {dict.nav.skipToContent}
    </a>

    <Nav lang={lang} />

    {/* Full width, so a section can paint a band edge to edge; the measure
        lives on .shell inside each section. */}
    <main id="main" class="w-full">
      <slot />
    </main>

    {/* The homepage ends on its own Contact section, which says what the
        footer's opening line would, so there the footer starts at its lists. */}
    <Footer lang={lang} call={!isHome} />

    <CommandPalette lang={lang} />

    <script>
      // A native <details> has no light dismiss: it stays open when you click
      // past it, when you press Escape, and when you follow a link inside it.
      // That last one matters for the section menu, where the link is an anchor
      // on the same page, so nothing navigates and the panel would sit there
      // over the section it just jumped to.
      //
      // One listener for every disclosure on the page rather than one per
      // component, which is why this lives in the layout.
      const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-menu]');

      const closeAll = (except?: Node) => {
        menus.forEach((menu) => {
          if (menu.open && menu !== except) menu.open = false;
        });
      };

      document.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;

        const inside = [...menus].find((menu) => menu.contains(target));
        closeAll(inside);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        const open = [...menus].find((menu) => menu.open);
        if (!open) return;

        open.open = false;
        open.querySelector('summary')?.focus();
      });

      menus.forEach((menu) => {
        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
        });
      });
    </script>

    <script>
      // The active-section indicator, and the one thing on this site that CSS
      // could not do. A nav link cannot be styled from the section it points
      // at: the two are in different subtrees, and `:target` only knows what
      // was clicked, not what is on screen.
      //
      // So: an observer with a band across the upper third of the viewport. A
      // section is current while its box crosses that band, which is roughly
      // where a reader is looking, and `aria-current="location"` carries the
      // state - announced as well as drawn. Styling is in global.css, on
      // .nav-link and .nav-row.
      //
      // The links are absolute (`/#about`), so this runs on every page and
      // simply observes nothing where the sections do not exist.
      const sectionLinks = document.querySelectorAll<HTMLElement>('[data-section-link]');

      if (sectionLinks.length > 0) {
        const byId = new Map<string, HTMLElement[]>();

        sectionLinks.forEach((link) => {
          const id = link.dataset.sectionLink;
          if (!id) return;
          byId.set(id, [...(byId.get(id) ?? []), link]);
        });

        const mark = (activeId: string) => {
          byId.forEach((links, id) => {
            links.forEach((link) => {
              if (id === activeId) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          });
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) mark(entry.target.id);
            });
          },
          // A band from 28% to 45% down the viewport. Narrow enough that only
          // one section is in it at a time, low enough that a section counts as
          // current once it is genuinely being read rather than as its first
          // pixel appears.
          { rootMargin: '-28% 0px -55% 0px' },
        );

        byId.forEach((_links, id) => {
          const section = document.getElementById(id);
          if (section) observer.observe(section);
        });
      }
    </script>
  </body>
</html>
