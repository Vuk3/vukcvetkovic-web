---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  The one section whose label is a sentence rather than a word, so it is the one
  section that sets its label as a statement across the top instead of hanging
  it in the margin. That is a fact about the content deciding the layout, which
  is also why this section looks unlike any other on the page.

  Two columns of hairline-topped rows. The rules stop at the column gap, which
  is what keeps four of them from reading as a 2x2 grid of cards.
*/}
<Section
  id="services"
  label={dict.services.label}
  width="services"
  tone={tone}
  head="statement"
>
  <ul class="svc-grid">
    {
      dict.services.items.map((item) => (
        <li class="svc reveal-item">
          <h3 class="svc-title">{item.title}</h3>
          <p class="mt-2 text-muted">{item.description}</p>
        </li>
      ))
    }
  </ul>
</Section>
