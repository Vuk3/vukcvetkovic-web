---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  Four cards, two up. The label is a sentence rather than a word ("What I can
  help with"), which the section head takes in its stride - it is a heading, so
  it wraps and sets at the same size as every other one.
*/}
<Section id="services" label={dict.services.label} width="wide" tone={tone}>
  <ul class="svc-grid">
    {
      dict.services.items.map((item) => (
        <li class="card reveal-item">
          <h3 class="svc-title">{item.title}</h3>
          <p class="mt-2.5 text-muted">{item.description}</p>
        </li>
      ))
    }
  </ul>
</Section>
