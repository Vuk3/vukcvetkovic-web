---
import { Braces, Briefcase, CloudCog, FolderOpen, Layers, ScanSearch } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

/*
 * One outline per service, in the order the dictionaries list them: the API,
 * the whole feature, the cloud, the review. By position because the services
 * are an array of prose with no ids - the four locales keep the same order, and
 * a fifth service would simply render without an icon until one is added here.
 */
const icons = [Braces, Layers, CloudCog, ScanSearch];

/*
 * What backs each service, from `services` in src/site.ts, by the same
 * position. Enforced where it would otherwise turn into a silent gap: a
 * service with nothing under it, or a proof for a service that is not there.
 */
if (site.services.length !== dict.services.items.length) {
  throw new Error(
    `site.services has ${site.services.length} entries, services.items has ${dict.services.items.length}.`,
  );
}

/**
 * Where a service is shown done: a project's page, or its role in Experience.
 * A project brings its hue, so the proof is lit in the colour its card and
 * page are drawn in, and a role has none and keeps the site's accent.
 */
const proofOf = (proof: (typeof site.services)[number]['proof']) => {
  if ('project' in proof) {
    const project = site.projects.find((entry) => entry.id === proof.project);
    if (!project) throw new Error(`services: no project "${proof.project}".`);
    return {
      Icon: FolderOpen,
      href: localizePath(`/projects/${project.slug}/`, lang),
      name: dict.projects.items[project.id].title,
      hue: project.hue,
    };
  }
  const role = site.experience.find((entry) => entry.id === proof.role);
  if (!role) throw new Error(`services: no role "${proof.role}".`);
  return { Icon: Briefcase, href: '#experience', name: role.company, hue: undefined };
};
---

{/*
  Four rows across the measure, one per service: its icon and name, what it
  covers, and at the far end what it is done in and the place on the site it
  is shown done, so each row ends on proof rather than on a promise. Read down,
  the names are the list, and read across, a row is the whole claim. Rows rather
  than tiles in a grid, because four equal icon-and-text tiles were the
  plainest, most template thing the page had.
*/}
<Section id="services" label={dict.services.label} tone={tone}>
  <ul class="svc-list">
    {
      dict.services.items.map((item, index) => {
        const Icon = icons[index];
        const service = site.services[index];
        const proof = proofOf(service.proof);

        return (
          <li class="card svc-row reveal-item">
            {Icon && (
              <span class="svc-icon" aria-hidden="true">
                <Icon />
              </span>
            )}
            <h3 class="svc-title">{item.title}</h3>

            <div class="svc-copy">
              <p class="svc-body">{item.description}</p>
              {service.tech.length > 0 && (
                <ul class="svc-tags">
                  {service.tech.map((tech) => (
                    <li class="tag">
                      <TechIcon name={tech} class="tag-icon" />
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <a href={proof.href} class="svc-proof" data-hue={proof.hue}>
              <span class="tile-label">
                <span class="tile-icon">
                  <proof.Icon aria-hidden="true" />
                </span>
                {dict.services.proof}
              </span>
              <span class="svc-proof-name">{proof.name}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>
