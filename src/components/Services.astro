---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

<Section id="services" label={dict.services.label} tone={tone}>
  <ul class="space-y-5">
    {
      dict.services.items.map((item) => (
        <li>
          <h3 class="display text-[1.25rem]">{item.title}</h3>
          <p class="measure mt-1 text-muted">{item.description}</p>
        </li>
      ))
    }
  </ul>
</Section>
