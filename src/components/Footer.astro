---
import { ArrowUp } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

const year = new Date().getFullYear();
---

{/*
  The footer takes the ink panel, so every page on the site ends the same way -
  the homepage under its contact block, a project page under its takeaway, the
  404 under four lines of type. Where a panelled section sits directly above it
  the two share a ground and only the hairline separates them, which reads as
  one closing block rather than two.

  The name leads in the display voice with the year under it, rather than both
  being folded into one small copyright line: it is the last thing on the page
  and it may as well be his name.

  ⚠️ Back to top is written here but it is **not in the footer's row** - `.to-top`
  is `position: fixed`, so it floats at the bottom right of the page for the
  whole scroll. It stays in this component because the panel palette it inherits
  is what makes it a dark pill on a light page, and because the label should come
  from one place. See `.to-top` in global.css.

  The label is hidden on a phone and the `aria-label` carries the name there, so
  the arrow alone is still a named control rather than an unlabelled link.
*/}
<footer class="panel site-foot">
  <div class="shell shell-hero foot-inner">
    <div>
      <p class="foot-name">{site.name}</p>
      <p class="foot-note">&copy; {year} {site.domain}</p>

    </div>

    <a href="#main" class="cta-ghost to-top" aria-label={dict.footer.backToTop}>
      <span class="to-top-label">{dict.footer.backToTop}</span>
      <ArrowUp class="to-top-icon shrink-0" aria-hidden="true" />
    </a>
  </div>
</footer>
