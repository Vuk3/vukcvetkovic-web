---
/**
 * One request, drawn as tiles, and moving.
 *
 * The opening image of a project page and the one place it is allowed to be a
 * diagram, because the shape is the argument: a run reaches a single address,
 * fans out into services that do not know about each other, and gathers back
 * into one answer - or, on a round trip, comes back the way it went.
 *
 * It is HTML and CSS, not SVG. The nodes are the site's own objects - a tile,
 * the ink panel, `.tile-label`, `.chip` and `.mark-tile` with the real brand
 * marks - so the text wraps natively in four languages and nothing has to
 * estimate how wide "Ein Ordner, rekursiv als Bytes gelesen" sets. One markup
 * serves both arrangements: a container query in src/styles/flow.css lays it
 * out left to right from 60rem of stage width and as a vertical spine below.
 *
 * The connectors are CSS too: 2px borders drawn by the boxes they belong to,
 * each positioned against its own tile. That only works because the shape is
 * fixed - entry, core, a lane of parallel services, then an exit (a pipeline)
 * or back to the entry (a round trip) - and it is the shape all four projects
 * are. A fifth project with a different one is a reason to extend this
 * deliberately, not a gap to fill in advance.
 *
 * Everything project-shaped is read here: the words from the dictionary, the
 * shape and the marks from src/site.ts (`flowShape`, `flowTech`).
 *
 * ⚠️ The visual is `aria-hidden` and the run is announced from the `sr-only`
 * ordered list instead, in the order it happens. Read in DOM order the tiles
 * would announce the round trip's answer before the gateway that sends it.
 */
import { CornerDownRight, LogIn, PackageCheck, Split, Workflow } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import type { Project } from '../site';
import { brandStyle, type TechName } from '../tech';
import MarkTile from './MarkTile.astro';
import TechIcon from './TechIcon.astro';
import '../styles/flow.css';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const dict = getDict(lang);
const captions = dict.projects.flowCaptions;

/*
 * French sets a space before a colon, and the dictionaries write it as an
 * ordinary one, so in a narrow tile or under a line a row could start on the
 * colon alone ("Un seul format JSON / : cadres"). The words are left exactly
 * as written - only that one space is made non-breaking, before : ; ! and ?,
 * so the mark stays on the line with the word it belongs to.
 */
const keep = (text: string) => text.replace(/ ([:;!?])/g, ' $1');

const copy = dict.projects.items[project.id].flow;
const flow = {
  entry: keep(copy.entry),
  entryLabel: keep(copy.entryLabel),
  core: keep(copy.core),
  branches: copy.branches.map((branch) => ({ title: keep(branch.title), badge: keep(branch.badge) })),
  exit: keep(copy.exit),
  exitLabel: keep(copy.exitLabel),
  exitNote: keep(copy.exitNote),
};
const tech = project.flowTech;
const roundTrip = project.flowShape === 'roundTrip';

/*
 * The two rules `FlowTech` in src/site.ts cannot state as types, enforced where
 * they would otherwise turn into a silent gap: a service drawn with nobody's
 * marks, or a mark the project's own stack does not list.
 */
if (tech.branches.length !== flow.branches.length) {
  throw new Error(
    `${project.id}: flowTech.branches has ${tech.branches.length} entries, flow.branches has ${flow.branches.length}.`,
  );
}

const stacked = new Set<TechName>(project.stack.flatMap((group) => group.items));
const stray = [...tech.entry, ...tech.core, ...tech.branches.flat(), ...tech.exit].filter(
  (name) => !stacked.has(name),
);

if (stray.length > 0) {
  throw new Error(`${project.id}: flowTech names ${stray.join(', ')}, which the stack does not list.`);
}

/*
 * The story, as one table.
 *
 * `step` is an element's place in the assembly: CSS turns it into a slice of
 * the stage's scroll, so the diagram builds in the order a request takes it.
 * `at` is when, as a fraction of one packet cycle, its packet leaves, and
 * `ping` when its tile lights up - one shared cycle and per-segment delays,
 * so every packet stays in step with every other for as long as the page is
 * open.
 *
 * The fractions are paired with the windows in flow.css: 12% of the cycle for
 * a line from tile to tile, and a run over two lines - the trunk and a
 * branch - split 4% to the trunk and 14% to the branch, so the packet keeps
 * its speed across the join. Each `at` below is the previous line's start
 * plus its window. Change one and the rest have to move with it.
 *
 * `row` is a beat's time in the horizontal arrangement where it differs, and
 * only a round trip has any: there the answer comes back the long way round,
 * down the rail, along the channel under the lane and up into the core's
 * floor (`back`, which the vertical spine does not draw), over three lines
 * of 9.5%, 13.5% and 9.5%. So the channel starts sooner than the spine's
 * trunk does, and the core's second light, the answer's line and the entry's
 * light all come later. The core lights as the packet passes under its
 * floor, a little before the back leg's window closes under the tile.
 *
 * A round trip's cycle is longer because its run is: it comes all the way
 * back, and the core lights twice - once for the request, once for the answer.
 */
interface Beat {
  step?: number;
  at?: number;
  ping?: number;
  row?: number;
}

interface Story {
  cycle: string;
  entry: Beat;
  req: Beat;
  core: Beat;
  fan: Beat;
  lane: Beat;
  branchIn: Beat;
  service: Beat;
  branchOut: Beat;
  out: Beat;
  back?: Beat;
  answered?: Beat;
  ans?: Beat;
  exit?: Beat;
}

const story: Story = roundTrip
  ? {
      cycle: '6s',
      entry: { step: 0, ping: 0.65, row: 0.77 },
      req: { step: 1, at: 0.02 },
      core: { step: 2, ping: 0.14 },
      fan: { step: 3, at: 0.14 },
      lane: { step: 3 },
      branchIn: { step: 4, at: 0.18 },
      service: { step: 4, ping: 0.32 },
      branchOut: { step: 5, at: 0.34 },
      out: { step: 5, at: 0.48, row: 0.435 },
      back: { step: 5.5, at: 0.57 },
      answered: { ping: 0.52, row: 0.63 },
      ans: { step: 6, at: 0.53, row: 0.65 },
    }
  : {
      cycle: '4.8s',
      entry: { step: 0, ping: 0 },
      req: { step: 1, at: 0.02 },
      core: { step: 2, ping: 0.14 },
      fan: { step: 3, at: 0.14 },
      lane: { step: 3 },
      branchIn: { step: 4, at: 0.18 },
      service: { step: 4, ping: 0.32 },
      branchOut: { step: 5, at: 0.34 },
      out: { step: 5, at: 0.48 },
      exit: { step: 6, ping: 0.52 },
    };

/*
 * A service's place in the lane, which is all its connectors need to find
 * the others. `k` is how many service pitches the middle of the stack sits
 * below this one's top (n/2 - i), `j` how many services come after it. `side`
 * says which way its branch runs to the middle: from above, from below, or
 * straight across for the middle one of three.
 */
const n = flow.branches.length;
const middle = (n - 1) / 2;

const services = flow.branches.map((branch, i) => ({
  title: branch.title,
  badge: branch.badge,
  marks: tech.branches[i],
  side: i < middle ? 'above' : i > middle ? 'below' : 'level',
  vars: `--i:${i};--j:${n - 1 - i};--k:${n / 2 - i}`,
}));

/** A beat as inline custom properties, leaving out what it does not have. */
const vars = (beat: Beat | undefined) =>
  Object.entries(beat ?? {})
    .filter(([, value]) => value !== undefined)
    .map(([name, value]) => `--${name}:${value}`)
    .join(';');

/*
 * The accessible reading, in run order: where it starts, what it carries,
 * where that lands, the services together as one nested step, and then where
 * the answer goes. Captions lead each line so the list says what each stop
 * *is*, and the marks follow as the facts they are.
 */
const withMarks = (text: string, marks: TechName[]) =>
  marks.length > 0 ? `${text} - ${marks.join(', ')}` : text;
---

<div class="flow" data-shape={project.flowShape} style={`--cycle:${story.cycle}`}>
  <ol class="sr-only">
    <li>{withMarks(`${captions.entry}: ${flow.entry}`, tech.entry)}</li>
    {flow.entryLabel && <li>{flow.entryLabel}</li>}
    <li>{withMarks(`${captions.core}: ${flow.core}`, tech.core)}</li>
    <li>
      {captions.lane}
      <ul>
        {services.map((service) => (
          <li>{withMarks([service.title, service.badge].filter(Boolean).join(' - '), service.marks)}</li>
        ))}
      </ul>
    </li>
    {
      roundTrip ? (
        flow.exitLabel && <li>{flow.exitLabel}</li>
      ) : (
        <li>
          {withMarks(
            [`${captions.exit}: ${flow.exit}`, flow.exitNote].filter(Boolean).join(' - '),
            tech.exit,
          )}
        </li>
      )
    }
  </ol>

  <div class="card flow-stage" aria-hidden="true">
    <div class="flow-grid" style={`--n:${n}`}>
      <div class="flow-node flow-term flow-entry" style={vars(story.entry)}>
        <p class="tile-label">
          <span class="tile-icon"><LogIn /></span>
          {captions.entry}
        </p>
        <div class="flow-body">
          <p class="flow-title">{flow.entry}</p>
          {
            tech.entry.length > 0 && (
              <span class="flow-emblem">
                {tech.entry.map((name) => (
                  <MarkTile name={name} />
                ))}
              </span>
            )
          }
        </div>
      </div>

      {/*
        The gap between the entry and the core, as a grid item of its own
        because it holds the payloads. On a round trip it carries two lines:
        the request going forward over the answer coming back, each with the
        payload it carries written beside it.
      */}
      <div class="flow-gap">
        {flow.entryLabel && <p class="flow-label flow-label-req">{flow.entryLabel}</p>}
        <span class="flow-line flow-req" style={vars(story.req)}>
          <span class="flow-head"></span>
          <span class="flow-pk"></span>
        </span>
        {
          roundTrip && (
            <span class="flow-line flow-ans" style={vars(story.ans)}>
              <span class="flow-head"></span>
              <span class="flow-pk"></span>
            </span>
          )
        }
        {roundTrip && flow.exitLabel && <p class="flow-label flow-label-ans">{flow.exitLabel}</p>}
      </div>

      {/*
        A round trip's last leg in the horizontal arrangement: from the channel
        under the lane, along under the core and up into its floor. Placed on
        the core's grid area rather than inside the core, because only the
        area knows where the channel is - it is as tall as the row - and set
        before the core so the core's tile paints over the half of it that
        runs up behind the tile. The spine draws none of it.
      */}
      {
        roundTrip && (
          <span class="flow-line flow-back" style={vars(story.back)}>
            <span class="flow-pk"></span>
          </span>
        )
      }

      <div class="flow-node flow-core panel" style={vars(story.core)}>
        <p class="tile-label">
          <span class="tile-icon"><Workflow /></span>
          {captions.core}
        </p>
        <div class="flow-body">
          <p class="flow-title">{flow.core}</p>
          {
            tech.core.length > 0 && (
              <span class="flow-emblem">
                {tech.core.map((name) => (
                  <MarkTile name={name} />
                ))}
              </span>
            )
          }
        </div>
        {
          roundTrip && (
            <>
              {/* The answer arriving: the second light, and the head the
                  back leg lands on, both the core's own. */}
              <span class="flow-ring" style={vars(story.answered)}></span>
              <span class="flow-head flow-head-back"></span>
            </>
          )
        }
      </div>

      <div class="flow-lane" style={vars(story.lane)}>
        <p class="tile-label flow-lane-cap">
          <span class="tile-icon"><Split /></span>
          {captions.lane}
        </p>

        {/*
          The stack is the box every connector in and out of the lane is
          measured from: its middle is where the fan joins and where a
          pipeline gathers, and its edges are where the trunks start.
        */}
        <div class="flow-stack">
          {
            services.map((service) => (
              <div class="flow-svc" data-side={service.side} style={`${service.vars};${vars(story.service)}`}>
                <div class="flow-svc-text">
                  <p class="flow-svc-title">{service.title}</p>
                  {service.badge && <p class="flow-badge">{service.badge}</p>}
                </div>
                {service.marks.length > 0 && (
                  <span class="flow-marks">
                    {service.marks.map((name) => (
                      <span class="chip" style={brandStyle(name)}>
                        <TechIcon name={name} class="chip-icon" />
                        {name}
                      </span>
                    ))}
                  </span>
                )}
                <span class="flow-branch flow-branch-in" style={vars(story.branchIn)}>
                  <span class="flow-pk"></span>
                </span>
                <span class="flow-branch flow-branch-out" style={vars(story.branchOut)}>
                  <span class="flow-pk"></span>
                </span>
                <span class="flow-head flow-head-in"></span>
              </div>
            ))
          }

          <span class="flow-line flow-fan" style={vars(story.fan)}>
            <span class="flow-pk"></span>
          </span>

          {/* A pipeline's gathered line to the exit, or a round trip's way
              back towards the core. */}
          <span class="flow-line flow-out" style={vars(story.out)}>
            <span class="flow-head"></span>
            <span class="flow-pk"></span>
          </span>
        </div>
      </div>

      {
        !roundTrip && (
          <div class="flow-node flow-term flow-exit" style={vars(story.exit)}>
            <p class="tile-label">
              <span class="tile-icon">
                <PackageCheck />
              </span>
              {captions.exit}
            </p>
            <div class="flow-body">
              <p class="flow-title">{flow.exit}</p>
              {tech.exit.length > 0 && (
                <span class="flow-emblem">
                  {tech.exit.map((name) => (
                    <MarkTile name={name} />
                  ))}
                </span>
              )}
              {flow.exitNote && (
                <p class="flow-note">
                  <CornerDownRight class="flow-note-icon" />
                  {flow.exitNote}
                </p>
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>
