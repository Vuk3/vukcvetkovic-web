---
import { Mail } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import BrandIcon from './BrandIcon.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

// Globbed rather than imported directly: a missing portrait yields an empty
// object instead of a build error, so the placeholder can stand in for it.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/portrait.{webp,avif,png,jpg,jpeg}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

/*
 * The master's own dimensions, handed over whole.
 *
 * The card frames the photograph at its own 3:4, so nothing is cropped: no arm
 * cut off at the frame and, on a phone, no head cut in half. That was the cost
 * of stretching the column and covering it, and it is not a cost worth paying.
 * One 730-wide variant is emitted, which is 2x at the largest rendering.
 */
const portraitWidth = 730;
const portraitHeight = 976;

/*
 * The name on two lines, split off the single string in site.ts rather than
 * hardcoded here, so the name is still stated in exactly one place.
 *
 * Two lines is what buys the size: on one line "Vuk Cvetković" runs out of
 * measure around 60px. It stays one <h1> with one accessible name.
 */
const [firstName, ...restOfName] = site.name.split(' ');
const lastName = restOfName.join(' ');

/*
 * The role, taken from the current role in Experience rather than written out
 * again here. It is the same fact, and the hero is not the place for a second
 * copy of it that can drift.
 */
const role = dict.experience.roles.ncoded.role;

/*
 * The stack, as the first thing under the fold-line rather than only in Skills.
 *
 * It is the same list Skills sets out grouped further down, flattened here, so
 * the hero answers what he works with using content the page already holds - no
 * new copy, and nothing about it to keep in sync.
 */
const stack = site.skillGroups.flatMap((group) => group.items);

const profiles = [
  { label: dict.contact.linkedinLabel, href: site.links.linkedin, brand: 'linkedin' as const },
  { label: dict.contact.githubLabel, href: site.links.github, brand: 'github' as const },
];
---

{/*
  No scroll reveal anywhere in here - the hero is in view at first paint and
  runs the load sequence instead.
*/}
<section class="hero">
  <div class="shell shell-hero">
    <div class="hero-grid">
      <div>
        <p class="hero-role enter">{role}</p>

        <h1 class="display-name">
          <span class="enter-name">{firstName}</span>
          <span class="enter-name" style="--enter-delay:110ms">{lastName}</span>
        </h1>

        <div class="enter" style="--enter-delay:380ms">
          <p class="hero-lead">{dict.hero.positioning}</p>

          <div class="hero-actions">
            <a href={`mailto:${site.email}`} class="cta">
              <Mail class="size-[1.05rem]" aria-hidden="true" />
              {dict.hero.cta}
            </a>

            {
              profiles.map((profile) => (
                <a href={profile.href} target="_blank" rel="me noopener" class="cta-ghost">
                  <BrandIcon name={profile.brand} class="size-[0.95rem] shrink-0" />
                  {profile.label}
                </a>
              ))
            }
          </div>

          <ul class="hero-chips">
            {
              stack.map((tech) => (
                <li class="chip">
                  <TechIcon name={tech} class="chip-icon" />
                  {tech}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/*
        The portrait, as a card the size of the column - so the photograph is
        part of the composition rather than an avatar dropped beside a heading.
        The card is what integrates it: same border, same radius and same tone
        as everything else on the page.
      */}
      <figure class="portrait enter enter-portrait" style="--enter-delay:240ms">
        <div class="portrait-frame">
          {
            portrait ? (
              <Image
                src={portrait}
                alt={dict.hero.portraitAlt}
                width={portraitWidth}
                height={portraitHeight}
                quality={86}
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <div
                role="img"
                aria-label={dict.hero.portraitAlt}
                class="flex h-full items-center justify-center p-2 text-center text-[11px] leading-tight text-muted"
              >
                {dict.hero.portraitPlaceholder}
              </div>
            )
          }
        </div>
      </figure>
    </div>
  </div>
</section>
