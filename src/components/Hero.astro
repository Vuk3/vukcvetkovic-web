---
import { Mail } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

// Globbed rather than imported directly: a missing portrait yields an empty
// object instead of a build error, so the placeholder can stand in for it.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/portrait.{webp,avif,png,jpg,jpeg}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

// Displayed size in CSS pixels, and the only knob for it — the placeholder
// follows it too. 1x, 2x and 3x variants are emitted, so the source's short edge
// should be at least three times this. Sharp crops a non-square source to centre.
const portraitSize = 128;
---

{/* No .reveal here: the hero is in view at first paint, so it animates on load. */}
<section class="section-grid hero-grid pt-16">
  {
    portrait ? (
      <Image
        src={portrait}
        alt={dict.hero.portraitAlt}
        width={portraitSize}
        height={portraitSize}
        densities={[1, 2, 3]}
        quality={90}
        loading="eager"
        class="enter shrink-0 rounded-lg object-cover"
      />
    ) : (
      <div
        role="img"
        aria-label={dict.hero.portraitAlt}
        style={`width:${portraitSize}px;height:${portraitSize}px`}
        class="enter flex shrink-0 items-center justify-center rounded-lg bg-surface p-2 text-center text-[10px] leading-tight text-muted"
      >
        {dict.hero.portraitPlaceholder}
      </div>
    )
  }

  <div class="enter-stagger">
    <h1 class="font-heading text-4xl leading-[1.05] font-semibold tracking-tight sm:text-5xl">
      {site.name}
    </h1>
    <p class="mt-4 max-w-[34rem] text-muted">{dict.hero.positioning}</p>

    <p class="mt-8">
      <a href={`mailto:${site.email}`} class="link inline-flex items-center gap-2">
        <Mail class="size-4" aria-hidden="true" />
        {dict.hero.cta}
      </a>
    </p>
  </div>
</section>
