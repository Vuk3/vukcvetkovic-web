---
import { Mail } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

// Globbed rather than imported directly: a missing portrait yields an empty
// object instead of a build error, so the placeholder can stand in for it.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/portrait.{webp,avif,png,jpg,jpeg}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

// Intrinsic width in CSS pixels for the largest rendering, which is 288px at
// lg. 1x and 2x variants are emitted, so the source's short edge should be at
// least 576px - the 730px master clears it without being upscaled. The
// displayed size is CSS, not this number: see .portrait in global.css.
const portraitWidth = 288;

/*
 * The name on two lines, split off the single string in site.ts rather than
 * hardcoded here, so the name is still stated in exactly one place.
 *
 * Two lines is what buys the size: on one line "Vuk Cvetković" runs out of
 * measure around 60px, and at 132px stacked it is the masthead the page was
 * missing. It stays one <h1> with one accessible name.
 */
const [firstName, ...restOfName] = site.name.split(' ');
const lastName = restOfName.join(' ');
---

{/* No scroll reveal here: the hero is in view at first paint and animates on load. */}
<section class="hero">
  <div class="shell shell-hero">
    <div class="hero-head">
      <h1 class="display-name">
        <span class="enter-name">{firstName}</span>
        <span class="enter-name" style="--enter-delay:120ms">{lastName}</span>
      </h1>

      {/*
        The portrait's lower edge lands on the baseline of the last name (see
        `align-items: end` on .hero-head), which is what makes the two read as
        one block rather than as an avatar beside a heading. Nothing else is in
        this box, so nothing can push the image off that baseline.
      */}
      <div class="portrait enter" style="--enter-delay:300ms">
        <div class="portrait-frame">
          {
            portrait ? (
              <Image
                src={portrait}
                alt={dict.hero.portraitAlt}
                width={portraitWidth}
                height={portraitWidth}
                densities={[1, 2]}
                quality={90}
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <div
                role="img"
                aria-label={dict.hero.portraitAlt}
                class="flex aspect-square items-center justify-center bg-surface p-2 text-center text-[11px] leading-tight text-muted"
              >
                {dict.hero.portraitPlaceholder}
              </div>
            )
          }
        </div>
      </div>
    </div>

    <div class="hero-foot enter" style="--enter-delay:440ms">
      <p class="hero-lead">{dict.hero.positioning}</p>

      <p class="hero-cta">
        <a href={`mailto:${site.email}`} class="cta">
          <Mail class="size-[1.05rem]" aria-hidden="true" />
          {dict.hero.cta}
        </a>
      </p>
    </div>
  </div>
</section>
