---
/**
 * The homepage body, shared by / and /[lang]/ so the two routes cannot drift.
 * Section order is fixed here.
 */
import type { Lang } from '../i18n/types';
import About from './About.astro';
import Contact from './Contact.astro';
import Education from './Education.astro';
import Experience from './Experience.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Services from './Services.astro';
import Skills from './Skills.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Hero lang={lang} />
<About lang={lang} />
<Skills lang={lang} />
<Experience lang={lang} />
<Education lang={lang} />
<Projects lang={lang} />

{/*
  The two sections aimed at someone deciding whether to write to him sit
  together on the surface tone, which gives the page a second half rather than
  one uninterrupted sheet. They share a single band, so the tone changes once.
*/}
<div class="band mt-24 py-20">
  <Services lang={lang} />
  <Contact lang={lang} />
</div>
