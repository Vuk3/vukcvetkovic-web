---
/**
 * The homepage body, shared by / and /[lang]/ so the two routes cannot drift.
 * Section order is fixed here.
 */
import type { Lang } from '../i18n/types';
import About from './About.astro';
import Contact from './Contact.astro';
import Education from './Education.astro';
import Experience from './Experience.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Services from './Services.astro';
import Skills from './Skills.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/*
  Tones alternate straight down the page, with no two neighbours sharing one.
  Experience and Education did share a tone, on the grounds that they are the
  same kind of dated list, but the two then read as one long block and the
  boundary between them disappeared.

  Contact takes the third tone, the tinted one, which is the page ending rather
  than another step in the alternation.
*/}
<Hero lang={lang} />
<About lang={lang} tone="band" />
<Skills lang={lang} />
<Experience lang={lang} tone="band" />
<Education lang={lang} />
<Projects lang={lang} tone="band" />
<Services lang={lang} />
<Contact lang={lang} tone="close" />
