---
/**
 * The homepage body, shared by / and /[lang]/ so the two routes cannot drift.
 * Section order is fixed here.
 *
 * The homepage's own rules are home.css, inlined into the four home pages and
 * nothing else - a rule in global.css is paid for by every page on the site.
 */
import type { Lang } from '../i18n/types';
import About from './About.astro';
import Contact from './Contact.astro';
import Experience from './Experience.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Services from './Services.astro';
import Skills from './Skills.astro';
import '../styles/home.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/*
  Tone is spent twice on the page, not on every other section.

  Strict alternation of ground and band turned out to be its own kind of
  uniformity: eight blocks of equal weight, each starting and ending the same
  way. What separates a section from its neighbour is what it puts in its
  tiles, which leaves tone free to set a section apart from the rest.

  So Projects is banded, because it is the section the page is for, and Contact
  takes the ink panel - the page ending on the surface the hero opens on.
*/}
<Hero lang={lang} />
<About lang={lang} />
<Skills lang={lang} />
<Experience lang={lang} />
<Projects lang={lang} tone="band" />
<Services lang={lang} />
<Contact lang={lang} tone="panel" />
