---
/**
 * The homepage body, shared by / and /[lang]/ so the two routes cannot drift.
 * Section order is fixed here.
 */
import type { Lang } from '../i18n/types';
import About from './About.astro';
import Contact from './Contact.astro';
import Education from './Education.astro';
import Experience from './Experience.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Services from './Services.astro';
import Skills from './Skills.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/*
  Tone is spent twice on the page, not on every other section.

  Sections used to alternate ground and band all the way down, and strict
  alternation turned out to be its own kind of uniformity: eight blocks of equal
  weight, each starting and ending the same way. What separates a section from
  its neighbour now is its measure and what it puts in its cards, which leaves
  tone free to do the thing a tone should do - set a section apart from the
  rest.

  So Projects is banded, because it is the section the page is for and a step in
  the ground is what lets a reader find it by scrolling. And Contact takes the
  ink panel, which is the page ending rather than another step in an
  alternation, and the same block the hero opens on.
*/}
<Hero lang={lang} />
<About lang={lang} />
<Skills lang={lang} />
<Experience lang={lang} />
<Education lang={lang} />
<Projects lang={lang} tone="band" />
<Services lang={lang} />
<Contact lang={lang} tone="panel" />
