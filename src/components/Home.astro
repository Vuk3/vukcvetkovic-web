---
/**
 * The homepage body, shared by / and /[lang]/ so the two routes cannot drift.
 * Section order is fixed here.
 *
 * The homepage's own rules are home.css, inlined into the four home pages and
 * nothing else - a rule in global.css is paid for by every page on the site.
 */
import type { Lang } from '../i18n/types';
import About from './About.astro';
import Contact from './Contact.astro';
import Experience from './Experience.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Services from './Services.astro';
import Skills from './Skills.astro';
import '../styles/home.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/*
  The page is a sequence of scenes, and tone is spent where a scene needs it
  rather than in alternating bands: the hero is an ink stage, Projects - the
  section the page is for - is the one full-width dark stage in the middle,
  and Contact closes on the ink, running on into the footer. Everything else
  stands on the paper and is told apart by what it does.
*/}
<Hero lang={lang} />
<About lang={lang} />
<Skills lang={lang} />
<Experience lang={lang} />
<Projects lang={lang} tone="panel" />
<Services lang={lang} />
<Contact lang={lang} tone="panel" />
