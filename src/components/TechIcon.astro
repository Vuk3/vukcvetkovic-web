---
/**
 * One mark from the stack, rendered from src/tech.ts.
 *
 * Filled brand marks and stroked outlines come through the same element, so the
 * only difference between them is which attributes get set. The brand colour is
 * handed over as `--brand` rather than as `color` directly, which lets the
 * stylesheet decide where it lands - `.chip-icon`, `.tag-icon` and
 * `.mark-tile-icon` in global.css each read it with a fallback of their own.
 */
import { brandStyle, getTechIcon, type TechName } from '../tech';

interface Props {
  name: TechName;
  class?: string;
}

const { name, class: className } = Astro.props;
const icon = getTechIcon(name);
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  class={className}
  style={brandStyle(name)}
  fill={icon.stroked ? 'none' : 'currentColor'}
  stroke={icon.stroked ? 'currentColor' : undefined}
  stroke-width={icon.stroked ? 2 : undefined}
  stroke-linecap={icon.stroked ? 'round' : undefined}
  stroke-linejoin={icon.stroked ? 'round' : undefined}
>
  <path d={icon.path}></path>
</svg>
