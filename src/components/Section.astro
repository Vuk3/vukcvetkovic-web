---
/**
 * A section: a heading, then content.
 *
 * One shape, and the variety comes from what a section puts inside it. Four
 * head shapes and a sticky label column were tried and thrown out: they spent
 * 12rem of every measure on a caption and left the content to spread thinly
 * across what was left, which is what made the page read as a document.
 *
 * So the heading is a real heading at real size, rising into a mask as the
 * section arrives, and the content is a bento of tiles - which is what carries
 * the page.
 *
 *   tone    Ground, the band, or the ink panel.
 *   space   `lite` is the quieter rhythm.
 *
 * There is no width: every section sits on the one `.shell` measure, so every
 * left edge on the site lines up with the header's.
 *
 * The `aside` slot is for what a section wants beside its heading - the link
 * out to the full project index. It is optional and most sections have none.
 */
export type SectionTone = 'base' | 'band' | 'panel';

interface Props {
  id: string;
  label: string;
  tone?: SectionTone;
  space?: 'full' | 'lite';
}

const { id, label, tone = 'base', space = 'full' } = Astro.props;

const toneClass = { base: '', band: 'section-band', panel: 'panel' }[tone];
const spaceClass = space === 'lite' ? 'sec-lite' : 'sec';
---

<section id={id} class:list={[spaceClass, toneClass]}>
  <div class="shell">
    <div class="sec-head">
      <h2 class="sec-label reveal-line">
        <span class="line-mask"><span class="line-in">{label}</span></span>
      </h2>
      <slot name="aside" />
    </div>

    <div class="sec-body">
      <slot />
    </div>
  </div>
</section>
