---
/**
 * A homepage section: a heading, then content, in one of three shapes.
 *
 * Every section used to be the same shape at the same width, which is most of
 * what made the page read as a CV rendered in a browser. The two things that
 * vary now are the width (`width`, see the .shell-* family in global.css) and
 * the shape of the head (`head`), and neither is decorative:
 *
 *   rail       The label hangs in the left margin on a corner bracket, with
 *              the content beside it. The default, and because each section
 *              sits at its own width the bracket lands at a different x each
 *              time - that shift is the page's rhythm.
 *   rule       A full-contrast rule across the whole column with the label on
 *              it, for the sections whose content wants the full width.
 *   statement  The label sets as a large phrase across the top. For Services,
 *              whose label is a sentence ("What I can help with") rather than
 *              a word and cannot hang in an 11rem margin.
 *
 * Tone is separate again: only About and Projects are banded, and Contact
 * closes on the tinted tone. Sections on the ground are separated by their
 * head and their spacing instead.
 */
export type SectionTone = 'base' | 'band' | 'close';
export type SectionHead = 'rail' | 'rule' | 'statement';

/** Keys of the .shell-* width family in global.css. */
export type SectionWidth = 'about' | 'skills' | 'timeline' | 'projects' | 'services' | 'contact';

interface Props {
  id: string;
  label: string;
  width: SectionWidth;
  tone?: SectionTone;
  head?: SectionHead;
  /** `lite` is the quieter rhythm, which Education uses. */
  space?: 'full' | 'lite';
}

const { id, label, width, tone = 'base', head = 'rail', space = 'full' } = Astro.props;

const toneClass = { base: '', band: 'section-band', close: 'section-close' }[tone];
const spaceClass = space === 'lite' ? 'sec-lite' : 'sec';
const widthClass = `shell-${width}`;
---

<section id={id} class:list={[spaceClass, toneClass]}>
  <div class:list={['shell', widthClass, head === 'rail' && 'sec-grid']}>
    {
      head === 'rail' && (
        <div class="sec-rail reveal">
          <h2 class="sec-label">{label}</h2>
        </div>
      )
    }

    {
      head === 'rule' && (
        <div class="sec-rule reveal">
          <h2 class="sec-label">{label}</h2>
        </div>
      )
    }

    {head === 'statement' && <h2 class="sec-statement reveal">{label}</h2>}

    <div
      class:list={[
        head === 'rule' && 'sec-body',
        head === 'statement' && 'sec-body sec-body-wide',
      ]}
    >
      <slot />
    </div>
  </div>
</section>
