---
/**
 * A homepage section: a heading in the left margin, then content.
 *
 * The heading used to be a tracked-out uppercase label. It is sentence case in
 * the display width now: an ALL-CAPS eyebrow over every section is decoration
 * pretending to be structure, and it made every block look the same weight.
 * Position and width carry the hierarchy here, which is why the size can stay
 * small without the heading reading as a caption.
 *
 * Sections are separated by whitespace alone — no cards, no rules.
 */
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section id={id} class="mt-24">
  <div class="shell section-grid">
    <h2 class="display text-sm lg:pt-1.5">{label}</h2>
    <div>
      <slot />
    </div>
  </div>
</section>
