---
/**
 * The projects, as a deck of case studies on the page's one dark stage.
 *
 * Every card is a case: the project's own request drawn large (FlowMini.astro)
 * - the same flow its page opens on, every node named in the reader's language
 * with its real marks - beside its year and context, its name, what it is,
 * what it does and the one measured result it leads with. Each is in its own
 * hue (`hue` in site.ts), so the four read as four products of one studio.
 *
 * On a desktop the deck stacks as it is read: each card sticks under the
 * header as it arrives and the next slides up over it while it steps back.
 * The mechanics are in project.css, and on anything smaller the cards simply
 * follow each other.
 *
 * Order comes from `site.projects`. Each card links to the project's own page
 * under /projects/, where the architecture, the results and the grouped stack
 * live. The project index (ProjectIndex.astro) lays the same cases out in
 * full. The markup is repeated rather than shared, because the heading level
 * and the arrival differ, and two similar blocks are not worth an abstraction.
 */
import { LayoutGrid } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site, type Project } from '../site';
import FlowMini from './FlowMini.astro';
import Section, { type SectionTone } from './Section.astro';
import TechIcon from './TechIcon.astro';
import '../styles/project.css';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

/* The spaced hyphen the copy uses as a dash, kept on the line with the word
   before it - see `keep` in ProjectDetail.astro. */
const keep = (text: string) => text.replace(/ ([:;!?]|-(?= ))/g, ' $1');

/** Live and source, dropping whichever has no URL yet. */
const outboundLinks = (links: { live?: string; source?: string }) =>
  [
    { href: links.live, label: dict.projects.liveLabel },
    { href: links.source, label: dict.projects.sourceLabel },
  ].filter((link): link is { href: string; label: string } => Boolean(link.href));

/**
 * A card's measured result, where its project has one (`outcome` in
 * src/site.ts): the figure, and the words round it with the figure it is
 * compared with, both printed in this locale - "0,916" in three of the four.
 */
const outcomeOf = (project: Project) => {
  if (!project.outcome) return undefined;
  const { value, from, digits, unit = '' } = project.outcome;
  const words = (dict.projects.outcomes as Partial<Record<string, string>>)[project.id];
  if (!words) throw new Error(`${project.id}: an outcome with no projects.outcomes.${project.id}.`);
  const number = new Intl.NumberFormat(lang, { minimumFractionDigits: digits, maximumFractionDigits: digits });
  return { figure: number.format(value) + unit, label: words.replace('{from}', number.format(from) + unit) };
};
---

<Section id="projects" label={dict.projects.label} tone={tone} class="theater">
  <a slot="aside" href={localizePath('/projects/', lang)} class="cta-ghost">
    <LayoutGrid class="size-[1rem] shrink-0" aria-hidden="true" />
    {dict.projects.all}
  </a>

  {/*
    `surface` puts each card back on the theme's own paper, so a white case
    stands on the ink stage with its drawing - which has an ink core of its
    own - drawn exactly as it would be on the ground. `stretch` makes the whole
    card the target while the accessible name stays the title alone, and outbound
    links are lifted above it with `above`. `--i` is the card's place in the
    deck, which sets where it sticks.

    The first card's drawing runs its request from load, and the others run theirs
    when the card is picked up.
  */}
  <ol class="deck">
    {
      site.projects.map((project, index) => {
        const copy = dict.projects.items[project.id];
        const page = localizePath(`/projects/${project.slug}/`, lang);
        const links = outboundLinks(project.links);
        const outcome = outcomeOf(project);

        return (
          <li class="card card-hover surface case reveal-item" data-hue={project.hue} style={`--i:${index}`}>
            <div class="case-pic">
              <FlowMini lang={lang} project={project} loop={index === 0 ? 'always' : 'hover'} class="case-flow" />

              {project.tech.length > 0 && (
                <ul class="case-tags" aria-label={dict.projects.detail.stack}>
                  {project.tech.map((tech) => (
                    <li class="tag">
                      <TechIcon name={tech} class="tag-icon" />
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="case-text">
              <p class="case-meta">
                <span class="case-year">{project.year}</span>
                <span>{keep(copy.context)}</span>
              </p>

              <h3
                class="case-title"
                style={`view-transition-name:project-${project.slug}-title;view-transition-class:title`}
              >
                <a href={page} class="entry-link stretch">
                  {copy.title}
                </a>
              </h3>

              <p class="case-tagline">{keep(copy.tagline)}</p>
              <p class="case-desc">{keep(copy.description)}</p>

              {outcome && (
                <p class="case-outcome">
                  <span class="case-outcome-figure">{outcome.figure}</span>
                  <span class="case-outcome-label">{outcome.label}</span>
                </p>
              )}

              <p class="case-more">
                <span class="link">{dict.projects.view}</span>
                {links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener" class="link above">
                    {link.label}
                  </a>
                ))}
              </p>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
