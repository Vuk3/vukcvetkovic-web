---
import { ArrowUpRight } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
---

<Section id="projects" label={dict.projects.label}>
  {/* Two columns once the content track is wide enough for two short blocks. */}
  <ul class="grid gap-8 lg:grid-cols-2 lg:gap-x-10">
    {
      site.projects.map((project) => {
        const copy = dict.projects.items[project.id];
        const links = [
          { href: project.links.live, label: dict.projects.liveLabel },
          { href: project.links.source, label: dict.projects.sourceLabel },
        ].filter((link): link is { href: string; label: string } => Boolean(link.href));

        return (
          <li>
            <h3 class="font-heading text-base font-medium">{copy.title}</h3>
            <p class="mt-1 text-muted">{copy.description}</p>

            <ul class="mt-3 flex flex-wrap gap-1.5">
              {project.tech.map((tech) => (
                <li class="rounded bg-surface px-2 py-0.5 text-[13px]">{tech}</li>
              ))}
            </ul>

            {links.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-4 text-[13px]">
                {links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener"
                      class="link inline-flex items-center gap-1"
                    >
                      {link.label}
                      <ArrowUpRight class="size-3.5" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>
</Section>
