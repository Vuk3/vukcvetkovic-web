---
/**
 * A showcase, not a list: the first project takes a card of its own, the rest
 * share a row of three.
 *
 * The featured card is the largest object on the page - the title at display
 * size, the tagline that says what the thing is, the description, and the full
 * summary stack in an inset beside it. That inset is as close as this section
 * gets to a picture, and it is an honest one: six technology names with their
 * marks say more about what the system is than a screenshot of an upload form
 * would.
 *
 * Order comes from `site.projects`, so which project is featured is decided
 * where the projects are, not here. Each card links to the project's own page
 * under /projects/, where the architecture, the results and the grouped stack
 * live.
 */
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

const [featured, ...rest] = site.projects;
const featuredCopy = dict.projects.items[featured.id];
const featuredPage = localizePath(`/projects/${featured.slug}/`, lang);

/** Live and source, dropping whichever has no URL yet. */
const outboundLinks = (links: { live?: string; source?: string }) =>
  [
    { href: links.live, label: dict.projects.liveLabel },
    { href: links.source, label: dict.projects.sourceLabel },
  ].filter((link): link is { href: string; label: string } => Boolean(link.href));

const featuredLinks = outboundLinks(featured.links);
---

<Section id="projects" label={dict.projects.label} width="projects" tone={tone}>
  <a slot="aside" href={localizePath('/projects/', lang)} class="cta-ghost">
    {dict.projects.all}
    <ArrowRight class="size-[0.95rem] shrink-0" aria-hidden="true" />
  </a>

  {/*
    `stretch` makes the whole card the target while the accessible name stays
    the title alone; the outbound links inside are lifted above it with
    `above`, or they would be covered by it.
  */}
  <article class="card card-hover project-featured reveal">
    <div class="project-featured-grid">
      <div>
        <p class="tag">{featured.year}</p>

        <h3 class="project-featured-title">
          <a href={featuredPage} class="entry-link stretch">{featuredCopy.title}</a>
        </h3>

        <p class="project-tagline">{featuredCopy.tagline}</p>

        <p class="measure mt-5 text-muted">{featuredCopy.description}</p>

        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
          <span class="link">{dict.projects.view}</span>
          {
            featuredLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener" class="link above">
                {link.label}
                <ArrowUpRight class="ml-1 inline size-[0.9rem] align-[-0.05em]" aria-hidden="true" />
              </a>
            ))
          }
        </p>
      </div>

      <div class="inset">
        <p class="stack-label">{dict.projects.detail.stack}</p>

        <ul class="mt-3 flex flex-wrap gap-2">
          {
            featured.tech.map((tech) => (
              <li class="chip">
                <TechIcon name={tech} class="chip-icon" />
                {tech}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </article>

  <ul class="project-grid">
    {
      rest.map((project) => {
        const copy = dict.projects.items[project.id];
        const page = localizePath(`/projects/${project.slug}/`, lang);
        const links = outboundLinks(project.links);

        return (
          <li class="card card-hover project reveal-item">
            <div>
              <p class="tag">{project.year}</p>

              <h3 class="project-title">
                <a href={page} class="entry-link stretch">
                  {copy.title}
                </a>
              </h3>

              <p class="mt-2.5 text-[15px] text-muted">{copy.description}</p>
            </div>

            <div class="project-aside">
              {project.tech.length > 0 && (
                <ul class="project-tags">
                  {project.tech.map((tech) => (
                    <li class="tag">
                      <TechIcon name={tech} class="tag-icon" />
                      {tech}
                    </li>
                  ))}
                </ul>
              )}

              <p class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[15px]">
                <span class="link">{dict.projects.view}</span>
                {links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener" class="link above">
                    {link.label}
                  </a>
                ))}
              </p>
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>
