---
/**
 * Two projects to a row, each a cell opened by a hairline.
 *
 * A cell rather than a card - no border, no fill - which is the same device
 * Services uses, so a grid of four stays in the same language as the hairline
 * rows everywhere else. The grid is `auto-fit`, so the count is never wired in:
 * it goes one up on a phone and two up here, and a fifth project just fills the
 * next cell. See `.project-grid` in global.css.
 *
 * The homepage carries the summary. Each cell links to the project's own page
 * under /projects/, where the architecture, the results and the full stack
 * live, which is what keeps this section short enough to scan.
 */
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

<Section id="projects" label={dict.projects.label} width="projects" tone={tone} head="rule">
  <ul class="project-grid">
    {
      site.projects.map((project) => {
        const copy = dict.projects.items[project.id];
        const page = localizePath(`/projects/${project.slug}/`, lang);

        const links = [
          { href: project.links.live, label: dict.projects.liveLabel, external: true },
          { href: project.links.source, label: dict.projects.sourceLabel, external: true },
        ].filter((link): link is { href: string; label: string; external: boolean } =>
          Boolean(link.href),
        );

        return (
          <li class="project reveal-item">
            <div>
              <h3 class="project-title">
                <a href={page} class="entry-link">
                  {copy.title}
                </a>
              </h3>
              <p class="measure mt-2 text-muted">{copy.description}</p>
            </div>

            <div class="project-aside">
              {project.tech.length > 0 && (
                <ul class="project-tags">
                  {project.tech.map((tech) => (
                    <li class="tag">
                      <TechIcon name={tech} class="tag-icon" />
                      {tech}
                    </li>
                  ))}
                </ul>
              )}

              <ul class="flex flex-wrap gap-5 text-[15px]">
                <li>
                  <a href={page} class="link">
                    {dict.projects.view}
                  </a>
                </li>
                {links.map((link) => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener" class="link">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ul>

  <p class="reveal mt-7">
    <a href={localizePath('/projects/', lang)} class="link">{dict.projects.all}</a>
  </p>
</Section>
