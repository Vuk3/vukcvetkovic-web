---
/**
 * One request, drawn as a chain of stages with a fork in the middle.
 *
 * This is the opening image of a project page and the one place either page is
 * allowed to be a diagram, because the shape *is* the argument: one request
 * fans out into two ecosystems and gathers back into one response, which is the
 * only reason the front end can treat the two as interchangeable.
 *
 * Three kinds of stage, and which one a stage gets comes from its position, not
 * from the copy - so any project's flow renders correctly without saying which
 * is which:
 *
 *   terminal  The two ends of the chain. Where the request starts and where the
 *             answer lands, as a filled pill.
 *   hub       The stage either side of the fork: what fans out, and what
 *             gathers in. The largest card in the diagram, on the accent.
 *   relay     Everything between them - the payload in flight. A dashed pill,
 *             because it is data crossing a boundary rather than a process
 *             sitting somewhere.
 *
 * The connectors are drawn in CSS: a 2px line with an arrowhead at its end, in
 * `.flow-in`, so every label stays selectable text and the whole thing takes
 * the theme with it. No SVG, no image, no library. See `.flow` in global.css,
 * which also collapses the fork into a single chain below 48rem.
 *
 * Any number of branches works. The columns come from an implicit grid, and
 * `--flow-n` is handed to the stylesheet because the two horizontal bars have
 * to end on the first and last branch stems and only the count can say where
 * those are.
 */
interface Props {
  /** Stages before the fork, in order. The last one is the hub. */
  before: string[];
  /** One entry per branch, each a few lines of its own. */
  branches: string[][];
  /** Stages after it. Here the first one is the hub. */
  after: string[];
}

const { before, branches, after } = Astro.props;

/**
 * The shape of one stage from where it sits in the chain.
 *
 * `edge` is the outer end of the run - the start of `before`, the end of
 * `after` - and `hub` the inner one, which is the stage the fork opens from or
 * closes into. A run of one stage is both, and the hub wins: a fork has to have
 * something to fan out of.
 */
type Kind = 'terminal' | 'hub' | 'relay';

const kindOf = (index: number, length: number, hubAt: 'first' | 'last'): Kind => {
  const hub = hubAt === 'last' ? length - 1 : 0;
  if (index === hub) return 'hub';
  if (index === (hubAt === 'last' ? 0 : length - 1)) return 'terminal';
  return 'relay';
};
---

<div class="flow-wrap reveal">
  <ol class="flow">
    {
      before.map((node, index) => (
        <li class="flow-stage">
          {index > 0 && <span class="flow-in" aria-hidden="true" />}
          <span class:list={['flow-node', `flow-${kindOf(index, before.length, 'last')}`]}>
            {node}
          </span>
        </li>
      ))
    }

    <li class="flow-fork">
      <ul class="flow-branches" style={`--flow-n:${branches.length}`}>
        {
          branches.map((branch) => (
            <li class="flow-branch">
              <span class="flow-in" aria-hidden="true" />

              <div class="flow-branch-card">
                {branch.map((line, index) => (
                  <span class:list={[index === 0 ? 'flow-service' : 'flow-model']}>{line}</span>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </li>

    {
      after.map((node, index) => (
        <li class="flow-stage">
          <span class="flow-in" aria-hidden="true" />
          <span class:list={['flow-node', `flow-${kindOf(index, after.length, 'first')}`]}>
            {node}
          </span>
        </li>
      ))
    }
  </ol>
</div>
