---
/**
 * A whole project page, shared by /projects/<slug>/ and its three prefixed
 * locales so the four cannot drift - the same arrangement as Home.astro.
 *
 * It renders whatever the project has and skips what it does not, so a project
 * with no measured comparison simply has no results section. Every entry under
 * `projects.items` in the dictionaries carries the same keys for exactly this
 * reason: one component, any project.
 *
 * Widths and tone come from the same family the homepage uses (see
 * Section.astro), and the page is built out of the same cards: the diagram is a
 * chain of them, the numbered steps a grid of them, the stack one per service.
 */
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import type { DiagramEdge, DiagramSpec, DiagramStage } from '../diagram-layout';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import type { Project, ResultFormat } from '../site';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import Section from './Section.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const dict = getDict(lang);
const copy = dict.projects.items[project.id];
const labels = dict.projects.detail;

const projectsPath = localizePath('/projects/', lang);

/*
 * Numbers are stored raw in src/site.ts and formatted here, so 17942 prints as
 * "17,942" in English and "17.942" in Serbian and German, and 0.916 keeps its
 * decimal comma outside English.
 *
 * The fraction digits are fixed rather than minimal because the precision is
 * part of the claim: a metric reported to three places should not lose a
 * trailing zero, since 0.800 and 0.8 are not the same statement, and a
 * stopwatch reading keeps the two places the run printed.
 */
const formatters: Record<ResultFormat, Intl.NumberFormat> = {
  count: new Intl.NumberFormat(lang),
  ratio: new Intl.NumberFormat(lang, { minimumFractionDigits: 3, maximumFractionDigits: 3 }),
  seconds: new Intl.NumberFormat(lang, { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
};

const links = [
  { href: project.links.live, label: dict.projects.liveLabel },
  { href: project.links.source, label: dict.projects.sourceLabel },
].filter((link): link is { href: string; label: string } => Boolean(link.href));

const meta = [
  { label: labels.year, value: project.year },
  { label: labels.context, value: copy.context },
  { label: labels.domain, value: copy.domain },
];

/*
 * The request diagram's spec: the copy from the dictionary, the topology from
 * src/site.ts, joined here because this is the one place that has both.
 *
 * ArchitectureDiagram takes stages and edges and knows nothing about projects,
 * so everything project-shaped is decided in these thirty lines - which is also
 * where to look when a fifth project does not fit the shape.
 */
const flow = copy.flow;
const captions = dict.projects.flowCaptions;
const roundTrip = project.flowShape === 'roundTrip';

const services = flow.branches.map((branch, index) => ({
  id: `service-${index}`,
  tier: 3 as const,
  title: branch.title,
  badges: branch.badge ? [branch.badge] : undefined,
}));

const stages: DiagramStage[] = [
  { id: 'entry', caption: captions.entry, nodes: [{ id: 'entry', tier: 1, title: flow.entry }] },
  { id: 'core', caption: captions.core, nodes: [{ id: 'core', tier: 2, title: flow.core }] },
  { id: 'lane', caption: captions.lane, lane: true, nodes: services },
];

const edges: DiagramEdge[] = [
  { from: 'entry', to: 'core', label: flow.entryLabel || undefined },
  ...services.map((service) => ({ from: 'core', to: service.id })),
];

if (roundTrip) {
  /* Back to the core, then back out to the terminal it came from. */
  edges.push(...services.map((service) => ({ from: service.id, to: 'core', return: true })));
  edges.push({ from: 'core', to: 'entry', label: flow.exitLabel || undefined });
} else {
  stages.push({
    id: 'exit',
    caption: captions.exit,
    nodes: [{ id: 'exit', tier: 1, title: flow.exit, note: flow.exitNote || undefined }],
  });
  edges.push(...services.map((service) => ({ from: service.id, to: 'exit' })));
}

const flowSpec: DiagramSpec = { id: project.id, stages, edges };
---

<article>
  {/*
    The page head. In view at first paint, so it runs the load sequence rather
    than a scroll reveal, and the beats are the same ones the hero uses: title,
    then the line under it, then the metadata.
  */}
  <header class="page-head">
    <div class="shell shell-projects">
      <a href={projectsPath} class="crumb enter">
        <ArrowLeft class="size-[0.95rem]" aria-hidden="true" />
        {dict.projects.back}
      </a>

      <h1 class="page-title enter" style="--enter-delay:60ms">{copy.title}</h1>

      <p class="page-lead enter" style="--enter-delay:160ms">{copy.tagline}</p>

      <div class="enter" style="--enter-delay:260ms">
        <dl class="page-meta">
          {
            meta.map((item) => (
              <div class="card page-meta-cell">
                <dt class="meta-label">{item.label}</dt>
                <dd class="meta-value">{item.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          links.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-3">
              {links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener" class="cta-ghost">
                    {link.label}
                    <ArrowUpRight class="size-[0.9rem] shrink-0" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </header>

  {/*
    The diagram runs its own reveal, in the order the request does, so it does
    not also take the section's `.reveal` - the two together would fade the
    whole block in and then assemble it inside itself.
  */}
  <Section id="flow" label={labels.flow} width="projects" tone="band">
    <ArchitectureDiagram spec={flowSpec} />
  </Section>

  {
    copy.overview.length > 0 && (
      <Section id="overview" label={labels.overview} width="text">
        <p class="about-lead reveal">{copy.overview[0]}</p>

        {copy.overview.length > 1 && (
          <div class="about-grid reveal mt-8">
            {copy.overview.slice(1).map((paragraph) => (
              <p class="text-muted">{paragraph}</p>
            ))}
          </div>
        )}
      </Section>
    )
  }

  {
    copy.steps.length > 0 && (
      <Section id="architecture" label={labels.architecture} width="projects">
        {/*
          Numbered, which nothing else on this site is: a request genuinely
          runs in this order, and the number is the only thing that can carry
          it. Two digits so the disc does not resize at the tenth step.
        */}
        <ol class="step-list">
          {copy.steps.map((step, index) => (
            <li class="card step reveal-item">
              <span class="step-n">{String(index + 1).padStart(2, '0')}</span>

              <div>
                <h3 class="step-title">{step.title}</h3>
                <p class="mt-2 text-[15px] text-muted">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {
    copy.features.length > 0 && (
      <Section id="features" label={labels.features} width="wide" tone="band">
        <ul class="svc-grid">
          {copy.features.map((feature) => (
            <li class="card reveal-item">
              <h3 class="svc-title">{feature.title}</h3>
              <p class="mt-2.5 text-muted">{feature.body}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    copy.dataset.length > 0 && (
      <Section id="dataset" label={labels.dataset} width="text">
        <div class="about-grid reveal">
          {copy.dataset.map((paragraph) => (
            <p class="text-muted">{paragraph}</p>
          ))}
        </div>
      </Section>
    )
  }

  {
    project.results && (
      <Section id="results" label={labels.results} width="timeline">
        {/*
          A real table, because this is real tabular data and any other shape
          would be decoration over it. It scrolls inside its own card rather
          than pushing the page sideways on a phone.
        */}
        <div class="card metrics-wrap reveal">
          <table class="metrics">
            <caption class="sr-only">{`${copy.title} - ${labels.results}`}</caption>
            <thead>
              <tr>
                {/* The first head names the row-label column, the rest the figures. */}
                {copy.results.columns.map((name) => (
                  <th scope="col">{name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {project.results.rows.map((row, rowIndex) => (
                <tr>
                  <th scope="row">{copy.results.rows[rowIndex]}</th>
                  {row.values.map((value, columnIndex) => (
                    <td>
                      {value === null
                        ? '-'
                        : formatters[project.results!.formats[columnIndex]].format(value)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {copy.results.notes.length > 0 && (
          <div class="about-grid reveal mt-7">
            {copy.results.notes.map((paragraph) => (
              <p class="text-muted">{paragraph}</p>
            ))}
          </div>
        )}
      </Section>
    )
  }

  {/*
    The stack, grouped by service rather than by category, so the list doubles
    as a map of what runs where. Same rows as the homepage's Skills section.
  */}
  <Section id="stack" label={labels.stack} width="wide">
    <dl class="card stack-card reveal">
      {
        project.stack.map((group) => (
          <div class="stack-row">
            <dt class="stack-name">{dict.projects.stackGroups[group.id]}</dt>
            <dd class="stack-chips">
              {group.items.map((item) => (
                <span class="chip">
                  <TechIcon name={item} class="chip-icon" />
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {
    copy.takeaway.length > 0 && (
      <Section id="takeaway" label={labels.takeaway} width="text" tone="panel">
        <div class="about-grid reveal">
          {copy.takeaway.map((paragraph) => (
            <p class="text-muted">{paragraph}</p>
          ))}
        </div>

        <p class="reveal mt-8">
          <a href={projectsPath} class="cta">
            <ArrowLeft class="size-[1.05rem]" aria-hidden="true" />
            {dict.projects.all}
          </a>
        </p>
      </Section>
    )
  }
</article>
