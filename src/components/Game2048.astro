---
/**
 * The 2048 page, shared by the four locales.
 *
 * The board is markup and nothing else: sixteen empty cells in a grid, an
 * absolutely positioned layer the tiles live in, and two panels over the top.
 * Every number on screen is real text at the reader's own size, so it scales,
 * it selects, and it stays crisp at any zoom - which a canvas version of this
 * would give up for nothing.
 *
 * ⚠️ Which panel is up is decided in CSS off `data-state` on the frame, see the
 * .g2048-* rules in global.css. The script sets one attribute and never
 * touches `hidden`, so the two panels can never both be showing.
 */
import { ArrowLeft, RotateCcw, Undo2 } from "@lucide/astro";
import type { Lang } from "../i18n/types";
import { getDict, localizePath } from "../i18n/utils";
import { site } from "../site";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

/*
 * This page names its own entry rather than being handed one, which is the
 * difference between a game and a project. A project page is one component
 * rendering whichever project the route resolved, so it takes the entry as a
 * prop. Every game has a component of its own, so the id is a constant here
 * and both halves of the lookup are checked at build time.
 */
const game = site.games.twentyFortyEight;
const copy = dict.games.items.twentyFortyEight;

const index = localizePath("/games/", lang);

/* Sixteen empty slots behind the tiles. They are the only thing that draws the
   grid, so a tile never has to paint a border to sit in one. */
const cells = Array.from({ length: 16 });
---

<div class="page-head">
  <div class="shell shell-wide">
    <a href={index} class="crumb enter">
      <ArrowLeft class="size-4" aria-hidden="true" />
      {dict.games.label}
    </a>

    <h1 class="page-title enter" style="--enter-delay:80ms">{game.name}</h1>

    <p class="page-lead enter" style="--enter-delay:160ms">{copy.lead}</p>
  </div>
</div>

<div class="sec-lite">
  <div class="shell shell-wide">
    <div
      class="g2048 enter"
      style="--enter-delay:240ms"
      data-game
      data-state="playing"
    >
      <div class="g2048-bar">
        <div class="g2048-meter">
          <span class="g2048-meter-label">{copy.score}</span>
          <span class="g2048-meter-value" data-score>0</span>
        </div>

        <div class="g2048-meter">
          <span class="g2048-meter-label">{copy.best}</span>
          <span class="g2048-meter-value" data-best>0</span>
        </div>

        <div class="g2048-actions">
          <button type="button" class="cta-ghost" data-action="undo" disabled>
            <Undo2 class="size-4 shrink-0" aria-hidden="true" />
            {copy.undo}
          </button>

          <button type="button" class="cta-ghost" data-action="restart">
            <RotateCcw class="size-4 shrink-0" aria-hidden="true" />
            {copy.newGame}
          </button>
        </div>
      </div>

      {
        /*
        The board is hidden from the accessibility tree and the live region
        below reports it instead. Sixteen cells that rewrite themselves on
        every keypress would otherwise be read out as a wall of numbers with
        no order a listener could hold on to.
      */
      }
      <div class="g2048-board" data-board aria-hidden="true">
        <div class="g2048-cells">
          {cells.map(() => <div class="g2048-cell" />)}
        </div>

        {
          /* Tiles are inserted here and never removed except when they merge. */
        }
        <div class="g2048-layer" data-layer></div>

        <div class="g2048-panel" data-panel="won">
          <p class="g2048-panel-title">{copy.won.title}</p>
          <p class="g2048-panel-body">{copy.won.body}</p>

          <div class="g2048-panel-actions">
            <button type="button" class="cta" data-action="keep-going"
              >{copy.won.keepGoing}</button
            >
            <button type="button" class="cta-ghost" data-action="restart"
              >{copy.newGame}</button
            >
          </div>
        </div>

        <div class="g2048-panel" data-panel="over">
          <p class="g2048-panel-title">{copy.over.title}</p>
          <p class="g2048-panel-body">{copy.over.body}</p>

          <div class="g2048-panel-actions">
            <button type="button" class="cta" data-action="restart"
              >{copy.over.restart}</button
            >
            <button type="button" class="cta-ghost" data-action="undo"
              >{copy.undo}</button
            >
          </div>
        </div>
      </div>

      <p class="g2048-hint">{copy.hint}</p>

      {
        /* The two words the announcement is built from ride on the element, so
          the script names nothing a reader would see. */
      }
      <p
        class="sr-only"
        aria-live="polite"
        data-live
        data-label-score={copy.score}
        data-label-highest={copy.highest}
      >
      </p>
    </div>
  </div>
</div>

<Section id="how" label={copy.how.label} width="wide" tone="band">
  <ul class="svc-grid">
    {
      copy.how.items.map((item) => (
        <li class="card reveal-item">
          <h3 class="svc-title">{item.title}</h3>
          <p class="mt-2.5 text-muted">{item.description}</p>
        </li>
      ))
    }
  </ul>
</Section>

<Section id="build" label={copy.close.label} width="wide" tone="panel">
  <div class="prose-columns text-muted">
    {copy.close.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>

<script>
  import { mount } from "../games/2048/game";
  import { scoreRecord } from "../games/record";

  /*
   * The page's side of the game: the two figures, the record, and the buttons.
   *
   * Everything about the board itself is in the module. This holds the things
   * that are the page's business rather than the game's - what a number is
   * called, where the record is kept, and what a screen reader is told.
   */
  const root = document.querySelector<HTMLElement>("[data-game]");
  const board = root?.querySelector<HTMLElement>("[data-board]");
  const layer = root?.querySelector<HTMLElement>("[data-layer]");

  if (root && board && layer) {
    const scoreOut = root.querySelector<HTMLElement>("[data-score]");
    const bestOut = root.querySelector<HTMLElement>("[data-best]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    const undoButtons = root.querySelectorAll<HTMLButtonElement>(
      '[data-action="undo"]'
    );

    const lang = document.documentElement.lang || "en";
    const format = new Intl.NumberFormat(lang);

    /*
     * The record is signed, so a figure typed into the storage inspector is
     * thrown away on the next load rather than shown. What that is and is not
     * worth is in record.ts, and it is worth reading before trusting it.
     *
     * The predicate is this game's half of it: a merge scores the tile it
     * produced, always a power of two of at least four, so a real 2048 score
     * is a multiple of four and most invented numbers fail on arithmetic
     * before the signature is reached.
     */
    const record = scoreRecord("game-2048-best", (value) => value % 4 === 0);

    let best = record.read();
    if (bestOut) bestOut.textContent = format.format(best);

    const controller = mount({
      root,
      board,
      layer,

      onScore(score, gained) {
        if (scoreOut) scoreOut.textContent = format.format(score);

        /*
         * The points a move was worth, floating off the score.
         *
         * It is the only feedback that says *why* the number changed, and
         * without it a merge chain reads as the score jumping on its own. The
         * node removes itself when its animation ends, so nothing accumulates
         * over a long game.
         */
        if (gained > 0 && scoreOut?.parentElement) {
          const gain = document.createElement("span");
          gain.className = "g2048-gain";
          gain.textContent = `+${format.format(gained)}`;
          gain.addEventListener("animationend", () => gain.remove());
          scoreOut.parentElement.append(gain);
        }

        if (score <= best) return;
        best = score;
        if (bestOut) bestOut.textContent = format.format(best);
        record.write(best);
      },

      onState(state) {
        root.dataset.state = state;
      },

      onAnnounce(score, highest) {
        if (!live) return;

        // Two figures rather than the board: a listener can hold on to where
        // they are and what the biggest tile is, and cannot hold sixteen
        // numbers that change on every keypress.
        const scoreLabel = live.dataset.labelScore ?? "";
        const highestLabel = live.dataset.labelHighest ?? "";

        live.textContent = `${scoreLabel} ${format.format(score)}. ${highestLabel} ${format.format(highest)}.`;
      },

      onUndo(available) {
        for (const button of undoButtons) button.disabled = !available;
      },
    });

    root.addEventListener("click", (event) => {
      const action = (event.target as Element | null)?.closest<HTMLElement>(
        "[data-action]"
      )?.dataset.action;

      if (action === "restart") controller.restart();
      if (action === "undo") controller.undo();
      if (action === "keep-going") controller.keepGoing();
    });
  }
</script>
