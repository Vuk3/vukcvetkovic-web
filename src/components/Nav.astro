---
import { Menu, X } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

// Absolute, locale-aware hrefs so the header keeps working from a project page,
// where the sections are not on the current URL.
const home = localizePath('/', lang);

const sections = [
  { id: 'about', label: dict.nav.about },
  { id: 'skills', label: dict.nav.skills },
  { id: 'experience', label: dict.nav.experience },
  { id: 'education', label: dict.nav.education },
  { id: 'projects', label: dict.nav.projects },
  { id: 'services', label: dict.nav.services },
  { id: 'contact', label: dict.nav.contact },
];
---

{/*
  The header takes the ink panel, which is the one device on this site that
  re-declares the palette rather than styling its own contents - so the bar is a
  different surface from the page in both themes, and the wordmark, the rail,
  the two controls and the phone menu inside it all come out correct without a
  single header-specific colour. It is the same block that closes the page, so
  the two ends are bracketed in ink.

  Translucent with a blur, so the page still runs under it. The hairline and the
  padding are driven by scroll position - see .site-head and the head-settle
  keyframes in global.css - which is pure CSS on a scroll() timeline. Where that
  is unsupported it simply stays at the settled height with its hairline
  showing.

  It sits on the hero's measure, so the wordmark shares a left edge with the
  name underneath it, and the seven labels sit in a pill rail of their own -
  which is what keeps them reading as one control rather than as seven links
  loose in the header.

  `data-section-link` is the hook the layout's observer uses to mark which
  section is on screen. Both lists carry it, so the desktop row and the phone
  menu are marked together and the state is set once.
*/}
<header class="site-head panel">
  <div class="shell shell-hero head-inner">
    <a href={home} class="brand">{site.name}</a>

    {/* Seven labels need more room than md gives, especially in German. */}
    <nav aria-label={dict.nav.sections} class="ml-auto hidden lg:block">
      <ul class="nav-rail">
        {
          sections.map((section) => (
            <li>
              <a href={`${home}#${section.id}`} class="nav-link" data-section-link={section.id}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-6">
      <ThemeToggle lang={lang} />
      <LangSwitcher lang={lang} />

      {/*
        The same list again, behind a disclosure, for everything below lg. It is
        a native <details>, so it opens and closes with no script of its own, and
        the panel is absolutely positioned against the sticky header rather than
        against the <details>, which is what lets it span the full width.

        No landmark around this list: the desktop <nav> above already carries one
        named "Sections", and a second landmark with the same name only gives a
        screen reader two identical entries to choose between.
      */}
      <details class="group static lg:hidden" data-menu>
        <summary
          aria-label={dict.nav.sections}
          class="head-btn size-9 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
        >
          <Menu class="size-5 group-open:hidden" aria-hidden="true" />
          <X class="hidden size-5 group-open:block" aria-hidden="true" />
        </summary>

        <ul class="absolute inset-x-0 top-full border-b border-hairline bg-bg py-2">
          {
            sections.map((section) => (
              <li>
                <a
                  href={`${home}#${section.id}`}
                  class="shell shell-hero nav-row py-2.5"
                  data-section-link={section.id}
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</header>
