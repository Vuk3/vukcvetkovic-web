---
import { Gamepad2, Menu, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/types';
import { locales } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { languageNames, site } from '../site';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
/*
 * Vuk's V mark, the file the favicon set already ships, imported rather than
 * linked so the build emits it at the size it is shown: 36px and its 2x, as
 * webp, about 1 KB each against the 7.6 KB of the 180px PNG a phone was sent
 * for a 36px mark. The file in public/ is untouched and still the touch icon.
 */
import vMark from '../../public/apple-touch-icon.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

// Absolute, locale-aware hrefs so the header keeps working from a project page,
// where the sections are not on the current URL.
const home = localizePath('/', lang);

/*
 * The games index is a page, not a section, which is why it sits outside the
 * rail rather than becoming an eighth label in it. Every link in the rail is
 * an anchor on the homepage and this one is not.
 */
const games = localizePath('/games/', lang);

const sections = [
  { id: 'about', label: dict.nav.about },
  { id: 'skills', label: dict.nav.skills },
  { id: 'experience', label: dict.nav.experience },
  { id: 'education', label: dict.nav.education },
  { id: 'projects', label: dict.nav.projects },
  { id: 'services', label: dict.nav.services },
  { id: 'contact', label: dict.nav.contact },
];

/* The same page in each language, for the phone menu - see below. */
const languages = locales.map((locale) => ({
  locale,
  name: languageNames[locale],
  href: localizePath(Astro.url.pathname, locale),
  current: locale === lang,
}));
---

{/*
  A floating ink capsule on the shell's measure. The header element is only the
  sticky strip it rides in; the capsule takes `.panel`, the one device on this
  site that re-declares the palette rather than styling its own contents, so the
  wordmark, the rail, the controls and the phone menu inside it all come out
  correct without a single header-specific colour.

  Its padding settles as the page scrolls - see .head-capsule and the
  head-settle keyframes in global.css - which is CSS on a scroll() timeline.

  `data-section-link` is the hook the layout's observer uses to mark which
  section is on screen. Both lists carry it, so the desktop row and the phone
  menu are marked together and the state is set once.
*/}
<header class="site-head">
  <div class="shell">
    <div class="head-capsule panel">
      {/*
        Vuk's own V mark, the file the favicon set already ships, shown at the
        size of the controls beside it. Decorative: the name next to it is the
        link's accessible name.
      */}
      <a href={home} class="brand">
        <Image src={vMark} alt="" width={36} height={36} densities={[1, 2]} loading="eager" class="brand-mark" />
        <span>{site.name}</span>
      </a>

      {/* Seven labels need more room than md gives, especially in German. */}
      <nav aria-label={dict.nav.sections} class="ml-auto hidden lg:block">
        <ul class="nav-rail">
          {
            sections.map((section) => (
              <li>
                <a href={`${home}#${section.id}`} class="nav-link" data-section-link={section.id}>
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1.5 lg:ml-2">
        {/*
          Desktop only. Below lg the rail collapses into the disclosure and this
          goes with it, since a phone looks in the menu anyway; the row inside
          the disclosure is the same link.
        */}
        <a href={games} class="head-btn head-game hidden lg:inline-flex" aria-label={dict.nav.games}>
          <Gamepad2 class="size-[1.05rem] shrink-0" aria-hidden="true" />
          {/*
            The word waits for xl. At lg the seven labels in the rail are already
            at the width they need - in German especially - and a pill with a
            word in it beside them is what pushes the row over. The icon alone
            still marks the spot, and `aria-label` carries the name either way.
          */}
          <span class="hidden xl:inline">{dict.nav.games}</span>
        </a>

        <ThemeToggle lang={lang} />

        {/*
          The switcher is a desktop control. Below lg the capsule holds the
          wordmark, the theme and the menu, and nothing else fits beside "Vuk
          Cvetković" at 360px, so the four languages move into the menu as a row
          of plain links.
        */}
        <div class="hidden lg:block">
          <LangSwitcher lang={lang} />
        </div>

        {/*
          The same list again, behind a disclosure, for everything below lg. It
          is a native <details>, so it opens and closes with no script of its
          own, and the menu is absolutely positioned against the capsule rather
          than against the <details>, which is what lets it span the capsule's
          width.

          No landmark around this list: the desktop <nav> above already carries
          one named "Sections", and a second landmark with the same name only
          gives a screen reader two identical entries to choose between.
        */}
        <details class="group static lg:hidden" data-menu>
          <summary
            aria-label={dict.nav.sections}
            class="head-btn cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          >
            <Menu class="size-5 group-open:hidden" aria-hidden="true" />
            <X class="hidden size-5 group-open:block" aria-hidden="true" />
          </summary>

          <ul class="head-menu">
            {
              sections.map((section) => (
                <li>
                  <a href={`${home}#${section.id}`} class="nav-row" data-section-link={section.id}>
                    {section.label}
                  </a>
                </li>
              ))
            }

            <li class="head-menu-game">
              <a href={games} class="nav-row">
                <Gamepad2 class="size-5 shrink-0" aria-hidden="true" />
                {dict.nav.games}
              </a>
            </li>

            <li class="head-menu-langs">
              <ul class="foot-langs" aria-label={dict.nav.language}>
                {languages.map((language) => (
                  <li>
                    <a
                      href={language.href}
                      hreflang={language.locale}
                      lang={language.locale}
                      aria-current={language.current ? 'page' : undefined}
                    >
                      {language.name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          </ul>
        </details>
      </div>
    </div>
  </div>
</header>
