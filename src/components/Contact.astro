---
import { Mail } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import BrandIcon from './BrandIcon.astro';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

/** Profile URLs read better without the scheme. */
const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

const channels = [
  {
    label: dict.contact.linkedinLabel,
    href: site.links.linkedin,
    text: bare(site.links.linkedin),
    brand: 'linkedin' as const,
  },
  {
    label: dict.contact.githubLabel,
    href: site.links.github,
    text: bare(site.links.github),
    brand: 'github' as const,
  },
];
---

{/*
  The page's conclusion, and the only place the type gets loud again after the
  hero: the address itself sets at up to 48px, which makes it the thing the eye
  lands on and removes any question about what the reader is meant to do here.
  The two profiles follow it as small labelled links, under a rule, because they
  are where someone goes to check rather than to make contact.
*/}
<Section id="contact" label={dict.contact.label} width="contact" tone={tone}>
  <div class="reveal">
    <p class="contact-intro">{dict.contact.intro}</p>

    <div class="mt-10">
      <p class="channel-label">
        <Mail class="size-3.5 shrink-0" aria-hidden="true" />
        {dict.contact.emailLabel}
      </p>
      <a href={`mailto:${site.email}`} class="mail">{site.email}</a>
    </div>

    <ul class="channels">
      {
        channels.map((channel) => (
          <li>
            <p class="channel-label">
              <BrandIcon name={channel.brand} class="size-3.5 shrink-0" />
              {channel.label}
            </p>
            <a href={channel.href} target="_blank" rel="me noopener" class="link mt-1 inline-block">
              {channel.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
