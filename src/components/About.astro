---
import { Gamepad2, GraduationCap } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import GameMinis from './GameMinis.astro';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

/* The opening paragraph is the statement tile; the other two sit under it. */
const [lead, education, site] = dict.about.paragraphs;
---

{/*
  Three tiles: the opening statement across the full measure at display size,
  then the other two paragraphs side by side, Education at 4 columns and Games
  at 8.

  They are labelled with names the page already uses for what they are about -
  the degrees are Education, and the site with its seven games is Games - and
  the Games tile is on cobalt, the tile a link to the games and each of the
  seven boards under its paragraph a link to its own, because it is the one
  paragraph on the page that points somewhere a reader can go and try.

  The wider column is the Games tile's so the boards have the room, and the
  split is what lets them fill it: the Games paragraph ends above Education's,
  and the boards take the height between (see GameMinis.astro), so the two
  tiles end level. Measured in all four languages, the room under the Games
  paragraph on 4 and 8 is 71 to 121px at 1024, where the boards are 77px wide,
  71px at 1280 (98px wide) and 46 to 96px at 1440 (107px wide), where English
  falls under the boards' 4rem floor and Education ends 18px short of the row.
  5 and 7 left 22 to 46px, a strip, and 3 and 9 boards nearly twice as tall as
  wide in German at 1280.
*/}
<Section id="about" label={dict.about.label} tone={tone}>
  <div class="bento">
    <div class="card about-statement reveal-item sm:col-span-6 lg:col-span-12">
      <p class="about-lead">{lead}</p>
    </div>

    <div class="card about-note reveal-item sm:col-span-6 lg:col-span-4">
      <p class="tile-label">
        <span class="tile-icon"><GraduationCap aria-hidden="true" /></span>
        {dict.education.label}
      </p>
      <p class="about-body">{education}</p>
    </div>

    <div class="card card-hover tile-cobalt about-note reveal-item sm:col-span-6 lg:col-span-8">
      <p class="tile-label">
        <span class="tile-icon"><Gamepad2 aria-hidden="true" /></span>
        <a href={localizePath('/games/', lang)} class="stretch">{dict.nav.games}</a>
      </p>
      <p class="about-body">{site}</p>
      <GameMinis lang={lang} />
    </div>
  </div>
</Section>
