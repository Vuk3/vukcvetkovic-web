---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

/* The opening paragraph is set large across the column and the rest run in two
 * columns under it. Splitting the array here rather than indexing in the
 * markup keeps the two layouts separate. */
const [lead, ...rest] = dict.about.paragraphs;
---

{/*
  Editorial rather than a card: the opening statement at display size, the rest
  in two columns beneath it.

  Nothing here is boxed. About is the one section on the page that is pure
  prose, and what sets it apart from its neighbours is exactly that - after a
  hero of chips and before a grid of cards, a run of text at reading size is the
  break.
*/}
<Section id="about" label={dict.about.label} width="text" tone={tone}>
  <p class="about-lead reveal">{lead}</p>

  <div class="about-grid reveal mt-8">
    {rest.map((paragraph) => <p class="text-muted">{paragraph}</p>)}
  </div>
</Section>
