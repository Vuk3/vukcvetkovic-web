---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  The narrowest section on the page apart from Contact, which is the point: 560
  points of prose beside the rail, around 66 characters, on a tone of its own.
  After the full-width hero it reads as the page drawing breath.

  The opening paragraph is set larger than the rest. Every paragraph on the page
  was the same size, so nothing told the eye where to start reading.
*/}
<Section id="about" label={dict.about.label} width="about" tone={tone}>
  <div class="reveal space-y-4">
    {
      dict.about.paragraphs.map((paragraph, index) =>
        index === 0 ? (
          <p class="text-[clamp(1.1875rem,1.7vw,1.375rem)] leading-[1.55] tracking-[-0.01em]">
            {paragraph}
          </p>
        ) : (
          <p>{paragraph}</p>
        ),
      )
    }
  </div>
</Section>
