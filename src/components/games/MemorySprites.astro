      </symbol>
    )}

    {/*
      A wedge seen from the cut side, tilted, because a whole melon is a green
      ball and says nothing at a card this size.
    */}
    {want('watermelon') && (
      <symbol id="mem-watermelon" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-blush)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <g transform="rotate(-12 50 52)">
          <path d="M12 36 A38 38 0 0 0 88 36 Z" style="fill:var(--mem-green-lo)"></path>
          <path d="M14 36 A36 36 0 0 0 86 36 Z" style="fill:var(--mem-green)"></path>
          <path d="M18 36 A32 32 0 0 0 82 36 Z" style="fill:var(--mem-lime-hi)"></path>
          <path d="M21 36 A29 29 0 0 0 79 36 Z" style="fill:var(--mem-red)"></path>
          <path d="M21 36 L79 36 L78.6 40 L21.4 40 Z" style="fill:var(--mem-red-hi)"></path>
          <g style="fill:var(--mem-ink)">
