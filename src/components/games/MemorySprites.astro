---
/**
 * The deck: thirty pictures, the back of a card, and the star the ratings are
 * drawn in.
 *
 * ⚠️ **A file of its own for the reason BattleshipSprites.astro is one**: the
 * game and its thumbnail on the index both draw from it, and a second copy of
 * a drawing is how a card ends up advertising a game that no longer looks like
 * that. For the same reason the ids are global and it must appear once per
 * document.
 *
 * `only` narrows it to the pictures a page actually shows. The thumbnail turns
 * five cards face up and has no business shipping the other twenty-five, while
 * the game has to carry all thirty because it does not know which it will deal.
 * The back and the rating star are always drawn - every page that has a card
 * has a face-down one.
 */
import type { PictureId } from '../../games/memory/game';

interface Props {
  only?: readonly PictureId[];
}

const { only } = Astro.props;

const want = (id: PictureId) => !only || only.includes(id);
---

{/*
  Every picture is a full card face on a 100 unit square, not an icon floating
  on a card, and three rules hold across all thirty.

  ⚠️ **The ground is part of the drawing.** Each symbol opens with its own
  pastel square and a softer disc under the subject, so a pair shares its
  colour as well as its shape - which is half of what the eye matches on -
  and the thumbnail cannot draw a card any differently from the game. The
  grounds are `--mem-bg-*` tokens with a dark value each, so the card answers
  the theme while the picture on it stays exactly the same object.

  ⚠️ **Flat fills, never a gradient or a clip path.** Both are referenced by
  `url(#…)`, and a reference declared inside a symbol is not reliably resolved
  from inside a `<use>` shadow tree. Depth is three tones instead - the
  colour, a highlight towards the top left, and a shade band down the right -
  which reads as round at sixty pixels and costs nothing.

  ⚠️ **Colour goes in through `style`, never a `fill` attribute**, for the
  reason the fleet gives: inherited custom properties are the only thing a
  document stylesheet can get into a `<use>`.

  Ten are fruit, ten are nature and ten are things, and within each ten the
  grounds are spread so that no two pictures sharing a colour of card also
  share a colour of subject.
*/}
<svg class="mem-sprites" aria-hidden="true" focusable="false">
  <defs>
    {/*
      Fruit. Every one of them is lit from the top left: a highlight on that
      side, a shade band down the right, and a stem and leaf where a stem and
      leaf go.
    */}
    {want('apple') && (
      <symbol id="mem-apple" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-mint)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <path d="M50 35 C41 27 21 29 20 49 C19 67 33 85 44 85 C47 85 48 83 50 83 C52 83 53 85 56 85 C67 85 81 67 80 49 C79 29 59 27 50 35Z" style="fill:var(--mem-red)"></path>
        <path d="M63 30 C74 33 80.5 41 80 50 C79 67 67 85 56 85 C53 85 52 83 50 83 C60 78 70 64 70 49 C70 40 67 34 63 30Z" style="fill:var(--mem-red-lo)"></path>
        <ellipse cx="32" cy="48" rx="4.5" ry="8.5" transform="rotate(-18 32 48)" style="fill:var(--mem-red-hi)"></ellipse>
        <path d="M50 37 C49 30 51 23 55 18" style="fill:none;stroke:var(--mem-brown);stroke-width:4;stroke-linecap:round"></path>
        <path d="M54 27 C57 17 69 13 75 17 C72 26 62 31 54 27Z" style="fill:var(--mem-green)"></path>
        <path d="M56.5 25.5 C62 22 67 19.5 72 18" style="fill:none;stroke:var(--mem-green-hi);stroke-width:1.6;stroke-linecap:round"></path>
      </symbol>
    )}

    {want('cherries') && (
      <symbol id="mem-cherries" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-sand)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <g style="fill:none;stroke:var(--mem-green-lo);stroke-width:3.5;stroke-linecap:round">
          <path d="M58 20 C50 31 41 42 37 53"></path>
          <path d="M58 20 C61 33 64 44 65 56"></path>
        </g>
        <path d="M58 20 C63 11 75 9 81 13 C76 21 66 23 58 20Z" style="fill:var(--mem-green)"></path>
        <path d="M60.5 19 C66 16 72 14 78 13.5" style="fill:none;stroke:var(--mem-green-hi);stroke-width:1.5;stroke-linecap:round"></path>
        <circle cx="36" cy="67" r="15" style="fill:var(--mem-red-lo)"></circle>
        <circle cx="34.5" cy="65.5" r="13.5" style="fill:var(--mem-red)"></circle>
        <ellipse cx="29" cy="60" rx="3" ry="4.6" transform="rotate(35 29 60)" style="fill:var(--mem-red-hi)"></ellipse>
        <circle cx="65" cy="70" r="15" style="fill:var(--mem-red-lo)"></circle>
        <circle cx="63.5" cy="68.5" r="13.5" style="fill:var(--mem-red)"></circle>
        <ellipse cx="58" cy="63" rx="3" ry="4.6" transform="rotate(35 58 63)" style="fill:var(--mem-red-hi)"></ellipse>
      </symbol>
    )}

    {want('lemon') && (
      <symbol id="mem-lemon" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-lilac)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <g transform="rotate(-28 50 55)">
          <ellipse cx="21.5" cy="55" rx="5.5" ry="4.8" style="fill:var(--mem-yellow-lo)"></ellipse>
          <ellipse cx="78.5" cy="55" rx="5.5" ry="4.8" style="fill:var(--mem-yellow-lo)"></ellipse>
          <ellipse cx="50" cy="55" rx="28" ry="21" style="fill:var(--mem-yellow-lo)"></ellipse>
          <ellipse cx="48.5" cy="53" rx="26.5" ry="18.5" style="fill:var(--mem-yellow)"></ellipse>
          <ellipse cx="40" cy="45.5" rx="11" ry="3.8" style="fill:var(--mem-yellow-hi)"></ellipse>
          <g style="fill:var(--mem-yellow-lo)">
            <circle cx="58" cy="51" r="1.1"></circle>
            <circle cx="64" cy="58" r="1.1"></circle>
            <circle cx="52" cy="60" r="1.1"></circle>
            <circle cx="42" cy="56" r="1.1"></circle>
            <circle cx="68" cy="49" r="1.1"></circle>
            <circle cx="34" cy="60" r="1.1"></circle>
          </g>
        </g>
        <path d="M75 38 C76 28 84 22 91 23 C90 31 83 38 75 38Z" style="fill:var(--mem-green)"></path>
        <path d="M77 36 C80 31 84 27 88.5 25" style="fill:none;stroke:var(--mem-green-hi);stroke-width:1.5;stroke-linecap:round"></path>
      </symbol>
    )}

    {want('strawberry') && (
      <symbol id="mem-strawberry" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-sea)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <path d="M50 86 C35 80 21 64 21 49 C21 38 31 32 41 34 C45 35 47 36 50 36 C53 36 55 35 59 34 C69 32 79 38 79 49 C79 64 65 80 50 86Z" style="fill:var(--mem-red)"></path>
        <path d="M66 34 C74 36 79 41 79 49 C79 64 65 80 50 86 C60 76 70 62 70 49 C70 42 68 37 66 34Z" style="fill:var(--mem-red-lo)"></path>
        <ellipse cx="31" cy="51" rx="4" ry="7.5" transform="rotate(-16 31 51)" style="fill:var(--mem-red-hi)"></ellipse>
        <g style="fill:var(--mem-yellow-hi)">
          <ellipse cx="40" cy="47" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="51" cy="46" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="62" cy="47" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="33" cy="59" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="45" cy="57" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="57" cy="57" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="69" cy="59" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="39" cy="68" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="51" cy="67" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="62" cy="68" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="45" cy="77" rx="1.4" ry="2.2"></ellipse>
          <ellipse cx="56" cy="77" rx="1.4" ry="2.2"></ellipse>
