    {want('grapes') && (
      <symbol id="mem-grapes" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-mint)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <path d="M50 29 C50 24 52 19 55 15" style="fill:none;stroke:var(--mem-brown);stroke-width:3.5;stroke-linecap:round"></path>
        <path d="M54 22 C59 13 71 11 77 15 C73 23 62 26 54 22Z" style="fill:var(--mem-green)"></path>
        <g>
          <g><circle cx="26" cy="38" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="25" cy="37" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="22.6" cy="34.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="42" cy="38" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="41" cy="37" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="38.6" cy="34.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="58" cy="38" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="57" cy="37" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="54.6" cy="34.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="74" cy="38" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="73" cy="37" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="70.6" cy="34.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="34" cy="52" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="33" cy="51" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="30.6" cy="48.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="50" cy="52" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="49" cy="51" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="46.6" cy="48.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="66" cy="52" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="65" cy="51" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="62.6" cy="48.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="42" cy="66" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="41" cy="65" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="38.6" cy="62.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="58" cy="66" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="57" cy="65" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="54.6" cy="62.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
          <g><circle cx="50" cy="80" r="8.5" style="fill:var(--mem-violet-lo)"></circle><circle cx="49" cy="79" r="7.3" style="fill:var(--mem-violet)"></circle><circle cx="46.6" cy="76.6" r="2" style="fill:var(--mem-violet-hi)"></circle></g>
        </g>
      </symbol>
    )}

    {/*
      A slice rather than a whole one, so it cannot be mistaken for the apple
      or the sun at a glance.
    */}
    {want('orange') && (
      <symbol id="mem-orange" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-sea)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <circle cx="50" cy="51" r="33" style="fill:var(--mem-orange-lo)"></circle>
        <circle cx="49" cy="50" r="31.5" style="fill:var(--mem-orange)"></circle>
        <circle cx="49" cy="50" r="27.5" style="fill:var(--mem-cream)"></circle>
        <circle cx="49" cy="50" r="25" style="fill:var(--mem-orange-hi)"></circle>
        <g style="fill:none;stroke:var(--mem-cream);stroke-width:2.4;stroke-linecap:round">
          <path d="M24 50 L74 50"></path>
          <path d="M49 25 L49 75"></path>
          <path d="M31.3 32.3 L66.7 67.7"></path>
          <path d="M31.3 67.7 L66.7 32.3"></path>
        </g>
        <circle cx="49" cy="50" r="3.4" style="fill:var(--mem-cream)"></circle>
        <path d="M31 38 C34 32 40 28 46 27" style="fill:none;stroke:var(--mem-white);stroke-width:2.6;stroke-linecap:round;opacity:0.55"></path>
      </symbol>
    )}

    {want('banana') && (
      <symbol id="mem-banana" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-blush)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <path d="M29 24 C17 48 25 72 47 82 C61 88 76 84 84 75 C85 73 84 71 82 71 C68 73 54 68 46 59 C39 51 38 38 39 24 C39 20 30 20 29 24Z" style="fill:var(--mem-yellow)"></path>
        <path d="M22 42 C21 60 30 74 47 82 C61 88 76 84 84 75 C70 81 56 79 45 72 C33 64 25 54 22 42Z" style="fill:var(--mem-yellow-lo)"></path>
        <path d="M34.5 30 C34 42 37 51 43 58" style="fill:none;stroke:var(--mem-yellow-hi);stroke-width:3.2;stroke-linecap:round"></path>
        <path d="M30 25 L30.5 15.5 C30.6 13.4 37.4 13.4 37.5 15.5 L38 25 Z" style="fill:var(--mem-brown)"></path>
        <path d="M82.5 71 C86.5 70.5 88.5 73.5 86.5 76 C85 77.5 82.8 77.6 81.6 76.6 Z" style="fill:var(--mem-brown-lo)"></path>
      </symbol>
    )}

    {/*
      The crown is five leaves and the body a lattice, and the lattice is
      drawn as lines laid inside the ellipse rather than clipped to it. A
      `clipPath` inside a symbol has the same trouble resolving from a `<use>`
      that a gradient does.
    */}
    {want('pineapple') && (
      <symbol id="mem-pineapple" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-sand)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <path d="M48 45 C40 44 31 40 26 32 C34 33 42 37 48 45Z" style="fill:var(--mem-green-lo)"></path>
        <path d="M52 45 C60 44 69 40 74 32 C66 33 58 37 52 45Z" style="fill:var(--mem-green-lo)"></path>
        <path d="M48 45 C40 39 34 31 32 20 C40 26 46 34 48 45Z" style="fill:var(--mem-green)"></path>
        <path d="M52 45 C60 39 66 31 68 20 C60 26 54 34 52 45Z" style="fill:var(--mem-green)"></path>
        <path d="M50 46 C45 35 45 23 50 12 C55 23 55 35 50 46Z" style="fill:var(--mem-green-hi)"></path>
        <ellipse cx="50" cy="65" rx="19.5" ry="23" style="fill:var(--mem-orange)"></ellipse>
        <ellipse cx="48.5" cy="64" rx="17.5" ry="21.5" style="fill:var(--mem-yellow-lo)"></ellipse>
        <g style="fill:none;stroke:var(--mem-orange-lo);stroke-width:1.6;stroke-linecap:round;opacity:0.7">
          <path d="M34 52 L58 84"></path>
          <path d="M37 45 L65 81"></path>
          <path d="M45 43 L68 72"></path>
          <path d="M31 63 L47 86"></path>
          <path d="M66 52 L42 84"></path>
          <path d="M63 45 L35 81"></path>
          <path d="M55 43 L32 72"></path>
          <path d="M69 63 L53 86"></path>
        </g>
        <ellipse cx="40" cy="58" rx="3.5" ry="8" transform="rotate(-10 40 58)" style="fill:var(--mem-yellow);opacity:0.8"></ellipse>
      </symbol>
    )}

    {/*
      Nature. The sun has two sets of rays, long and short, because twelve of
      one length read as a gear.
    */}
    {want('sun') && (
      <symbol id="mem-sun" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-sky)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <g style="fill:none;stroke:var(--mem-orange-hi);stroke-width:6;stroke-linecap:round">
          <path d="M50 13 L50 23"></path>
          <path d="M50 13 L50 23" transform="rotate(60 50 50)"></path>
          <path d="M50 13 L50 23" transform="rotate(120 50 50)"></path>
          <path d="M50 13 L50 23" transform="rotate(180 50 50)"></path>
          <path d="M50 13 L50 23" transform="rotate(240 50 50)"></path>
          <path d="M50 13 L50 23" transform="rotate(300 50 50)"></path>
        </g>
        <g style="fill:none;stroke:var(--mem-yellow);stroke-width:5;stroke-linecap:round">
          <path d="M50 17 L50 24" transform="rotate(30 50 50)"></path>
          <path d="M50 17 L50 24" transform="rotate(90 50 50)"></path>
          <path d="M50 17 L50 24" transform="rotate(150 50 50)"></path>
          <path d="M50 17 L50 24" transform="rotate(210 50 50)"></path>
          <path d="M50 17 L50 24" transform="rotate(270 50 50)"></path>
          <path d="M50 17 L50 24" transform="rotate(330 50 50)"></path>
        </g>
        <circle cx="50" cy="50" r="20" style="fill:var(--mem-orange)"></circle>
        <circle cx="49" cy="49" r="18.5" style="fill:var(--mem-yellow)"></circle>
        <path d="M38 44 C39 39 43 35 48 34" style="fill:none;stroke:var(--mem-yellow-hi);stroke-width:3.5;stroke-linecap:round"></path>
      </symbol>
    )}

    {/*
      The crescent is one path of two arcs, worked out from where the two
      circles meet, rather than a disc with a second disc painted over it in
      the sky colour - which would show as a patch the moment the ground under
      it changed.
    */}
    {want('moon') && (
      <symbol id="mem-moon" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-night)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot-night)"></circle>
