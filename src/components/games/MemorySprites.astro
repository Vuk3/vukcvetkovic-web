            <ellipse cx="64" cy="47" rx="1.8" ry="3" transform="rotate(-25 64 47)"></ellipse>
            <ellipse cx="43" cy="58" rx="1.8" ry="3" transform="rotate(15 43 58)"></ellipse>
            <ellipse cx="57" cy="58" rx="1.8" ry="3" transform="rotate(-15 57 58)"></ellipse>
          </g>
        </g>
      </symbol>
    )}

    {want('pear') && (
      <symbol id="mem-pear" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-peach)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
        <path d="M50 26 C43 26 41 32 41 39 C41 47 29 53 29 67 C29 80 39 87 50 87 C61 87 71 80 71 67 C71 53 59 47 59 39 C59 32 57 26 50 26Z" style="fill:var(--mem-lime)"></path>
        <path d="M56 28 C58 31 59 35 59 39 C59 47 71 53 71 67 C71 80 61 87 50 87 C58 82 63 75 63 65 C63 53 54 46 54 37 C54 33 55 30 56 28Z" style="fill:var(--mem-lime-lo)"></path>
        <ellipse cx="38" cy="65" rx="4" ry="8.5" transform="rotate(-12 38 65)" style="fill:var(--mem-lime-hi)"></ellipse>
        <path d="M50 28 C50 23 51 19 54 15" style="fill:none;stroke:var(--mem-brown);stroke-width:3.5;stroke-linecap:round"></path>
        <path d="M53 21 C56 13 66 10 72 13 C69 20 60 24 53 21Z" style="fill:var(--mem-green)"></path>
      </symbol>
