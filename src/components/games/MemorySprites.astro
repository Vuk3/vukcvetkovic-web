        <path d="M26 64 C30 74 40 80 50 80 C60 80 66 76 71.8 62.9 C64 72 56 75 48 74 C38 73 30 69 26 64Z" style="fill:var(--mem-yellow)"></path>
        <g style="fill:var(--mem-yellow)">
          <circle cx="31" cy="50" r="3.6"></circle>
          <circle cx="40" cy="64" r="2.6"></circle>
          <circle cx="33" cy="37" r="2"></circle>
        </g>
        <g style="fill:var(--mem-white)">
          <path d="M74 20 Q74 28 82 28 Q74 28 74 36 Q74 28 66 28 Q74 28 74 20Z"></path>
          <path d="M84 45 Q84 49 88 49 Q84 49 84 53 Q84 49 80 49 Q84 49 84 45Z"></path>
          <path d="M66 74 Q66 79 71 79 Q66 79 66 84 Q66 79 61 79 Q66 79 66 74Z"></path>
        </g>
      </symbol>
    )}

    {want('cloud') && (
      <symbol id="mem-cloud" viewBox="0 0 100 100">
        <rect width="100" height="100" style="fill:var(--mem-bg-lilac)"></rect>
        <circle cx="50" cy="52" r="40" style="fill:var(--mem-spot)"></circle>
