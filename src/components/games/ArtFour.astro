---
/**
 * The thumbnail for Four in a Row on the games index.
 *
 * A product shot of the real board rather than a crop of it: the same face and
 * discs the game draws, standing on the studio floor, with three more discs
 * standing on their edges beside it. The position is one a game could reach - six discs each,
 * red to move - and the red disc in the air is the move that wins it, on its
 * way into the fifth column to finish the diagonal. The whole game in one
 * picture, a moment before the line is drawn.
 */
import FourFace from "./FourFace.astro";
import "../../styles/games/four.css";

/** Column, row from the bottom, and whose. */
const discs: [number, number, 1 | 2][] = [
  [0, 0, 2],
  [1, 0, 1],
  [2, 0, 2],
  [3, 0, 1],
  [4, 0, 2],
  [5, 0, 1],
  [2, 1, 1],
  [3, 1, 2],
  [4, 1, 1],
  [2, 2, 2],
  [3, 2, 1],
  [4, 2, 2],
];
---

<div class="game-art game-art-four" aria-hidden="true">
  {/* Left to right: the one further back first, so the nearer ones overlap
      it. `--x` and `--y` place its foot, `--s` is its size. */}
  <span class="four-art-chip" style="--x:10;--y:9;--s:10.5;--tilt:-9deg">
    <span class="four-disc" data-player="2"></span>
  </span>
  <span class="four-art-chip" style="--x:18;--y:4.5;--s:13;--tilt:7deg">
    <span class="four-disc" data-player="1"></span>
  </span>
  <span class="four-art-chip" style="--x:27.5;--y:5.5;--s:11.5;--tilt:-3deg">
    <span class="four-disc" data-player="2"></span>
  </span>

  <div class="four-well">
    <div class="four-board">
      <div class="four-back"></div>

      <div class="four-discs">
        {
          discs.map(([column, row, player]) => (
            <span
              class="four-disc"
              data-player={player}
              style={`--col:${column};--row:${row}`}
            />
          ))
        }
        <span class="four-disc four-art-falling" data-player="1"></span>
      </div>

      <FourFace />
    </div>
  </div>
</div>
