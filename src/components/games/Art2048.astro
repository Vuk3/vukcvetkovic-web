---
/**
 * The thumbnail for 2048 on the games index.
 *
 * A still of a board rather than an icon or a screenshot. It is eight cells of
 * the real thing - the same tray, the same cells, the same `--g2048-tier`
 * ramp - so it costs no image, stays sharp at any size, and answers the theme
 * toggle along with everything else. A screenshot would do none of those and
 * would have to be re-shot every time the palette moved.
 *
 * The values are chosen to walk the ramp rather than to be a plausible
 * position: paper at one end and the gold 2048 at the other, so the card shows
 * what the game looks like at its best.
 */

/** Row-major, 5 across and 2 down. `null` is an empty cell. */
const cells = [
  [2, 8, null, 64, 256],
  [4, 32, 128, 1024, 2048],
].flat();
---

{/*
  Two elements, not one. The outer is the query container and the inner is the
  board, because a container cannot size itself in its own `cqi` - see the
  warning on `.game-art` in global.css.
*/}
<div class="game-art" aria-hidden="true">
  <div class="game-art-board">
    {
      cells.map((value) =>
        value === null ? (
          <span class="game-art-cell" />
        ) : (
          <span class="game-art-cell g2048-tier" data-tier={Math.log2(value)}>
            {value}
          </span>
        ),
      )
    }
  </div>
</div>
