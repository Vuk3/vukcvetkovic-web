---
/**
 * The /projects/ index, shared by the four locales.
 *
 * The same cases as the homepage's deck, on purpose, so a project looks the
 * same wherever it is listed - its request drawn large in its own hue beside
 * its name, what it is and what it measured - but in full, one after another
 * down the page, with the drawing on alternating sides so four in a column
 * read as a run of spreads. The whole card is the link, so the page needs no
 * separate call to action per card. Rules in src/styles/project.css.
 *
 * The markup repeats Projects.astro's rather than sharing a component: the
 * two differ in heading level and in how they arrive (the index's first card
 * is in view at first paint, so it enters on load rather than on scroll), and
 * two similar blocks are not worth an abstraction.
 */
import { CodeXml } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site, type Project } from '../site';
import FlowMini from './FlowMini.astro';
import TechIcon from './TechIcon.astro';
import '../styles/project.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const index = dict.projects.index;

/* The spaced hyphen the copy uses as a dash, kept on the line with the word
   before it - see `keep` in ProjectDetail.astro. */
const keep = (text: string) => text.replace(/ ([:;!?]|-(?= ))/g, '\u00a0$1');

/**
 * Live, and the source: a link per service where the project is several
 * repositories (`source` on its stack groups, the thesis's four), each named
 * for its service and announced as its source, otherwise the one in
 * `links.source`. Whichever has no URL yet is dropped.
 */
const outboundLinks = (project: Project) => {
  const services = project.stack.flatMap((group) =>
    group.source
      ? [
          {
            href: group.source,
            label: dict.projects.stackGroups[group.id],
            name: `${dict.projects.sourceLabel}: ${dict.projects.stackGroups[group.id]}`,
          },
        ]
      : [],
  );
  const sources: { href: string; label: string; name?: string }[] =
    services.length > 0 ? services : project.links.source ? [{ href: project.links.source, label: dict.projects.sourceLabel }] : [];
  return { live: project.links.live, sources };
};

/**
 * A card's measured result, where its project has one (`outcome` in
 * src/site.ts): the figure, and the words round it with the figure it is
 * compared with, both printed in this locale - "0,916" in three of the four.
 */
const outcomeOf = (project: Project) => {
  if (!project.outcome) return undefined;
  const { value, from, digits, unit = '' } = project.outcome;
  const words = (dict.projects.outcomes as Partial<Record<string, string>>)[project.id];
  if (!words) throw new Error(`${project.id}: an outcome with no projects.outcomes.${project.id}.`);
  const number = new Intl.NumberFormat(lang, { minimumFractionDigits: digits, maximumFractionDigits: digits });
  return { figure: number.format(value) + unit, label: words.replace('{from}', number.format(from) + unit) };
};

const page = (slug: string) => localizePath(`/projects/${slug}/`, lang);
---

{/*
  The title and the lead side by side from 64rem rather than stacked: the
  title is one short word in all four languages, and stacked, the lead ran
  the full measure as one long line under it. The same head as the games
  index.
*/}
<div class="page-head">
  <div class="shell work-index-head">
    <h1 class="page-title">
      <span class="line-mask enter-line" style="--enter-delay:40ms"
        ><span class="line-in">{index.heading}</span></span
      >
    </h1>
    <p class="page-lead enter" style="--enter-delay:160ms">{keep(index.intro)}</p>
  </div>
</div>

<div class="sec-lite work-index">
  <div class="shell">
    <ol class="cases">
      {
        site.projects.map((project, i) => {
          const copy = dict.projects.items[project.id];
          const links = outboundLinks(project);
          const outcome = outcomeOf(project);

          return (
            <li
              class:list={['card card-hover case', i === 0 ? 'enter' : 'reveal']}
              data-hue={project.hue}
              style={i === 0 ? '--enter-delay:260ms' : undefined}
            >
              <div class="case-pic">
                <FlowMini lang={lang} project={project} loop={i === 0 ? 'always' : 'hover'} class="case-flow" />

                {project.tech.length > 0 && (
                  <ul class="case-tags" aria-label={dict.projects.detail.stack}>
                    {project.tech.map((tech) => (
                      <li class="tag">
                        <TechIcon name={tech} class="tag-icon" />
                        {tech}
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <div class="case-text">
                <p class="case-meta">
                  <span class="case-year">{project.year}</span>
                  <span>{keep(copy.context)}</span>
                </p>

                <h2
                  class="case-title"
                  style={`view-transition-name:project-${project.slug}-title;view-transition-class:title`}
                >
                  <a href={page(project.slug)} class="entry-link stretch">
                    {copy.title}
                  </a>
                </h2>

                <p class="case-tagline">{keep(copy.tagline)}</p>
                <p class="case-desc">{keep(copy.description)}</p>

                {outcome && (
                  <p class="case-outcome">
                    <span class="case-outcome-figure">{outcome.figure}</span>
                    <span class="case-outcome-label">{outcome.label}</span>
                  </p>
                )}

                <p class="case-more">
                  <span class="link">{dict.projects.view}</span>
                  {links.live && (
                    <a href={links.live} target="_blank" rel="noopener" class="link above">
                      {dict.projects.liveLabel}
                    </a>
                  )}
                  {links.sources.length > 0 && (
                    <span class="case-source">
                      <CodeXml class="case-source-icon" aria-hidden="true" />
                      {links.sources.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener" class="link above" aria-label={link.name}>
                          {link.label}
                        </a>
                      ))}
                    </span>
                  )}
                </p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</div>
