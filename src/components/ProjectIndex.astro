---
/**
 * The /projects/ index, shared by the four locales.
 *
 * One card per project, in the same two-up grid the homepage uses for the three
 * it does not feature - so a project looks the same wherever it is listed. The
 * whole card is the link, so the page needs no separate call to action per row.
 */
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const index = dict.projects.index;
---

<div class="page-head">
  <div class="shell shell-projects">
    <h1 class="page-title enter">{index.heading}</h1>
    <p class="page-lead enter" style="--enter-delay:140ms">{index.intro}</p>
  </div>
</div>

<div class="sec-lite">
  <div class="shell shell-projects">
    <ol class="svc-grid">
      {
        site.projects.map((project) => {
          const copy = dict.projects.items[project.id];
          const href = localizePath(`/projects/${project.slug}/`, lang);

          return (
            <li class="card card-hover project reveal-item">
              <div>
                <p class="tag">{project.year}</p>

                <h2 class="project-title">
                  <a href={href} class="entry-link stretch">
                    {copy.title}
                  </a>
                </h2>

                <p class="mt-2.5 text-muted">{copy.description}</p>
              </div>

              {project.tech.length > 0 && (
                <ul class="project-tags mt-auto pt-5">
                  {project.tech.map((tech) => (
                    <li class="tag">
                      <TechIcon name={tech} class="tag-icon" />
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</div>
