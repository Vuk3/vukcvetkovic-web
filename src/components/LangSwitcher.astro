---
import { Check, ChevronDown, Languages } from '@lucide/astro';
import { locales, type Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { languageNames } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);

// Plain links to the same page in each locale — the disclosure only hides them.
const options = locales.map((locale) => ({
  locale,
  href: localizePath(Astro.url.pathname, locale),
  name: languageNames[locale],
  isCurrent: locale === lang,
}));
---

{/*
  A native disclosure, so the menu opens and closes without any script. The
  `data-menu` hook is what the layout's one dismissal listener looks for, which
  handles Escape and clicking past it for every disclosure on the page.
*/}
<details class="group relative" data-menu>
  <summary
    class="head-btn cursor-pointer list-none gap-1.5 px-3 text-[0.875rem] font-semibold [&::-webkit-details-marker]:hidden"
  >
    <Languages class="size-4" aria-hidden="true" />
    <span class="sr-only">{dict.nav.language}</span>
    <span class="uppercase">{lang}</span>
    <ChevronDown
      class="size-3 transition-transform duration-150 group-open:rotate-180"
      aria-hidden="true"
    />
  </summary>

  <nav
    aria-label={dict.nav.language}
    class="absolute right-0 z-50 mt-3 overflow-hidden rounded-card border border-hairline bg-bg p-1.5 shadow-[var(--site-float)]"
  >
    <ul class="min-w-44">
      {
        options.map((option) => (
          <li>
            <a
              href={option.href}
              hreflang={option.locale}
              lang={option.locale}
              aria-current={option.isCurrent ? 'page' : undefined}
              class:list={[
                'flex items-center gap-2.5 rounded-[var(--site-radius)] px-3 py-2.5 text-[1rem] font-medium transition-colors duration-150',
                option.isCurrent ? 'text-accent' : 'text-muted hover:bg-inset hover:text-fg',
              ]}
            >
              {option.isCurrent ? (
                <Check class="size-3.5 shrink-0" aria-hidden="true" />
              ) : (
                <span class="size-3.5 shrink-0" aria-hidden="true" />
              )}
              {option.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>

