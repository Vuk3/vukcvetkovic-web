---
/**
 * The /games/ index, shared by the four locales.
 *
 * A bento wall of seven cards, each opening on a thumbnail of the game itself.
 * The thumbnails are markup rather than images - a still of the real board,
 * built from the game's own pieces and tokens - so they cost nothing to serve,
 * stay sharp at any size, follow the theme toggle, and can move: every one
 * plays a small piece of its own game when the card is hovered. All of that is
 * CSS, in styles/games/index.css, and the page ships no script.
 */
import { Play } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site, type Game } from '../site';
import Art2048 from './games/Art2048.astro';
import ArtAccretion from './games/ArtAccretion.astro';
import ArtBattleship from './games/ArtBattleship.astro';
import ArtCube from './games/ArtCube.astro';
import ArtFour from './games/ArtFour.astro';
import ArtMemory from './games/ArtMemory.astro';
import ArtMinesweeper from './games/ArtMinesweeper.astro';
import '../styles/games/index.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const copy = dict.games;

type GameId = keyof typeof copy.items;

/**
 * One thumbnail per game, keyed the way the registry is.
 *
 * A `Record<GameId, …>` rather than a lookup with a fallback, so a game added
 * without art is a type error here instead of a card with a hole in it. These
 * are static markup components, so naming them all in one map costs nothing at
 * runtime - which is exactly why the game *pages* are not allowed to do this.
 */
const art: Record<GameId, typeof Art2048> = {
  twentyFortyEight: Art2048,
  minesweeper: ArtMinesweeper,
  memory: ArtMemory,
  accretion: ArtAccretion,
  battleship: ArtBattleship,
  cube: ArtCube,
  fourInARow: ArtFour,
};

/*
 * `Object.entries` widens the key to `string`, which is the one place the
 * registry's typing does not survive on its own. The cast is safe by
 * construction - the Record is keyed by GameId - and it is what lets the id
 * index the dictionary and the art map below without a lookup that could miss.
 */
const entries = Object.entries(site.games) as [GameId, Game][];
---

{/*
  The title and the lead side by side from 64rem rather than stacked: the
  title is one short word in all four languages, and stacked, the lead ran the
  full measure as one long line and a stray three-word second one. See
  `.games-head` in styles/games/index.css.

  The title's letters drop onto the line one after another and bounce as they
  land, like discs into a Four in a Row board - the one page on the site that
  is allowed to play before it is asked to. They are drawn apart from the
  word, which is said once from a hidden copy, so a screen reader hears
  "Games" and not five letters.
*/}
<div class="page-head">
  <div class="shell games-head">
    <h1 class="page-title games-title">
      <span class="sr-only">{copy.index.heading}</span>
      <span class="games-letters" aria-hidden="true">
        {
          Array.from(copy.index.heading).map((letter, index) => (
            <span class="games-letter" style={`--i:${index}`}>
              {letter}
            </span>
          ))
        }
      </span>
    </h1>
    <p class="page-lead enter" style="--enter-delay:320ms">{copy.index.intro}</p>
  </div>
</div>

<div class="sec-lite games-wall">
  <div class="shell">
    <ol class="bento">
      {
        entries.map(([id, game]) => {
          const Art = art[id];

          return (
            <li class="card card-hover game-card reveal-item" data-game={game.slug}>
              {/*
                The frame is a separate element from the art because it clips:
                the hover zoom scales the art inside it, and the corners have to
                stay put while it does. The art itself carries `aria-hidden`,
                so nothing a reader needs may go inside it.
              */}
              <div
                class="game-shot"
                style={`view-transition-name:game-${game.slug}-board;view-transition-class:board`}
              >
                <Art />
                {/* The way in, drawn on the screen when the card is picked
                    up: decoration over a card that is already the link. */}
                <span class="game-go" aria-hidden="true">
                  <Play />
                </span>
              </div>

              <div class="game-card-head">
                <h2
                  class="game-card-title"
                  style={`view-transition-name:game-${game.slug}-title;view-transition-class:title`}
                >
                  <a href={localizePath(`/games/${game.slug}/`, lang)} class="entry-link stretch">
                    {copy.items[id].name}
                  </a>
                </h2>
                <span class="pill-status" data-status={game.status}>
                  {copy.status[game.status]}
                </span>
              </div>

              <p class="game-card-tagline">{copy.items[id].tagline}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</div>
