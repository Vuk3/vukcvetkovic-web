---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  A card per role: the company at the top with its period as a pill beside it,
  the title under it, and the work as bullets.

  Employment is a sequence, and the short rule in the gap between two cards is
  what says so. A full timeline axis was tried and cost a column of its own for
  two dates, which is exactly the kind of space this page cannot afford.

  The period of the role he holds now takes the accent, which is the one place
  on the page the accent marks a fact rather than a link.
*/}
<Section id="experience" label={dict.experience.label} width="timeline" tone={tone}>
  <ol class="role-list">
    {
      site.experience.map((role) => {
        const copy = dict.experience.roles[role.id];
        return (
          /* Empty string rather than the boolean: Astro renders `false` as
             data-current="false", which [data-current] would still match. */
          <li class="card role reveal-item" data-current={role.current ? '' : undefined}>
            <div class="role-head">
              <div>
                <h3 class="role-company">{role.company}</h3>
                <p class="role-title">{copy.role}</p>
              </div>

              <p class="role-period">{role.period}</p>
            </div>

            <ul class="bullets mt-5 space-y-2.5 text-muted">
              {copy.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>
</Section>
