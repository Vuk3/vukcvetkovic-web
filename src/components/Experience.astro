---
import { Check, FileText, GraduationCap } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import elfak from '../assets/elfak.webp';
import ncodedLogo from '../assets/ncoded-logo.png';
import novateqLogo from '../assets/novateq-logo.jpg';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

/* Every stop on the rail, the roles and then the degrees, so the first and
   the last can be told from the rest whichever list they come from. */
const stops = site.experience.length + site.education.length;

// The crest's and the logos' displayed size in CSS pixels, the initial's: 1x,
// 2x and 3x are emitted, from the crest's 597px source and the logos' 200px.
const markSize = 56;

/*
 * Each company's own logo, as it publishes it, where its role would have its
 * initial: both companies start with N, so two initials said the same thing
 * twice. Keyed by role, and partial on purpose - a role with no logo here
 * keeps its initial rather than failing the build.
 */
const logos: Partial<Record<(typeof site.experience)[number]['id'], ImageMetadata>> = {
  ncoded: ncodedLogo,
  novateq: novateqLogo,
};
---

{/*
  One wide tile per stop: who and when across the top, what under it. Side by
  side the two roles came out 100px apart in height, because one has three
  points and the other two, and a bullet across the full measure ran to 150
  characters a line - so each tile is as tall as its own content, and on a
  desktop its points sit side by side under the head, each on a tile of its
  own at a readable width. Who and when in a column of their own beside the
  points filled a third of it and left the rest of the tile empty.

  A career is a sequence, and the rail joining the stops is what says so: one
  line from the first to the last, through the tiles and the gaps between them,
  which fills with the accent as the page scrolls past it. The roles come
  first, then the degrees, a chapter of their own under an "Education" heading
  whose icon is a stop on the rail, each with the school's crest where a role has its logo and
  its thesis where a role has its points, or its head alone while it has no
  thesis yet. The role he holds now takes the accent round its logo and on its
  period, and the degree under way takes it on its period, which are the
  places the accent marks a fact rather than a link; the period also carries a
  pulsing dot, so "2024 -" reads as running rather than cut off.

  A tile paints over whatever the tile above it draws, so the rail cannot be
  one element: each tile draws its own stretch - in from the tile above, across
  the gap, to its mark, and out from its mark to its own bottom edge - and the
  first has no way in and the last no way out. See the Experience block in
  home.css.
*/}
<Section id="experience" label={dict.experience.label} tone={tone}>
  <ol class="role-list">
    {
      site.experience.map((role, index) => {
        const copy = dict.experience.roles[role.id];
        const logo = logos[role.id];
        return (
          /* Empty string rather than the boolean: Astro renders `false` as
             data-current="false", which [data-current] would still match. */
          <li class="card role" data-current={role.current ? '' : undefined}>
            {index > 0 && <span class="role-rail role-rail-in" aria-hidden="true" />}
            {index < stops - 1 && <span class="role-rail role-rail-out" aria-hidden="true" />}
            <div class="role-head">
              {/* Decorative, as the crest is: the company is named beside it. */}
              {logo ? (
                <span class="role-mark role-logo" aria-hidden="true">
                  <Image src={logo} alt="" width={markSize} densities={[1, 2, 3]} loading="lazy" />
                </span>
              ) : (
                <span class="role-mark" aria-hidden="true">{role.company.charAt(0)}</span>
              )}

              <div class="min-w-0">
                <h3 class="role-company">{role.company}</h3>
                <p class="role-title">{copy.role}</p>
              </div>

              <p class="role-period">{role.period}</p>
            </div>

            <ul class="role-points">
              {copy.bullets.map((bullet) => (
                <li>
                  <span class="role-check" aria-hidden="true">
                    <Check />
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }

    {
      site.education.map((degree, index) => {
        const stop = site.experience.length + index;
        const copy = dict.education.degrees[degree.id];
        // A degree with no thesis yet has none to link, so only one that names a
        // project it cannot find fails the build.
        const thesis = degree.thesis && site.projects.find((project) => project.id === degree.thesis);
        if (degree.thesis && !thesis) throw new Error(`${degree.id}: no project "${degree.thesis}" for its thesis.`);

        return (
          <li
            class="card role role-degree"
            data-current={degree.current ? '' : undefined}
            data-chapter={index === 0 ? '' : undefined}
          >
            {stop > 0 && <span class="role-rail role-rail-in" aria-hidden="true" />}
            {stop < stops - 1 && <span class="role-rail role-rail-out" aria-hidden="true" />}
            {/* The chapter's caption, on the rail in the gap above the first
                degree. Visible text, so a screen reader hears where the
                degrees start as well. */}
            {index === 0 && (
              <p class="tile-label role-chapter">
                <span class="tile-icon">
                  <GraduationCap aria-hidden="true" />
                </span>
                {dict.education.label}
              </p>
            )}
            <div class="role-head">
              {/*
                Decorative, so the alt is empty: the school is named in the
                line beside it. The crest is navy on transparent, which
                disappears against the dark theme, so it sits on its own white
                disc, and the artwork is a circle already, so the disc reads as
                part of the seal rather than as a plate put behind it.
              */}
              <Image
                src={elfak}
                alt=""
                width={markSize}
                densities={[1, 2, 3]}
                loading="lazy"
                class="role-crest"
              />

              <div class="min-w-0">
                <h3 class="role-company">{copy.degree}</h3>
                <p class="role-title">{copy.school}</p>
              </div>

              <p class="role-period">{degree.period}</p>
            </div>

            {thesis && (
              <a href={localizePath(`/projects/${thesis.slug}/`, lang)} class="role-thesis">
                <span class="tile-label">
                  <span class="tile-icon">
                    <FileText aria-hidden="true" />
                  </span>
                  {copy.thesis}
                </span>
                <span class="role-thesis-title">{dict.projects.items[thesis.id].title}</span>
                <span class="role-thesis-line">{dict.projects.items[thesis.id].tagline}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</Section>
