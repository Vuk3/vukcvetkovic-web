---
import { Check } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  One wide tile per role, in two columns: who and when on the left, what on the
  right. Side by side the two roles came out 100px apart in height, because
  one has three points and the other two, and a stacked tile with its bullets
  across the full measure ran to 150 characters a line - so each tile is as tall
  as its own content and its bullets sit at a readable width.

  Employment is a sequence, and the line joining the two initials is what says
  so. The role he holds now takes the accent on its initial and on its period,
  which is the one place the accent marks a fact rather than a link; the period
  also carries a pulsing dot, so "2024 -" reads as running rather than cut off.
*/}
<Section id="experience" label={dict.experience.label} tone={tone}>
  <ol class="role-list">
    {
      site.experience.map((role) => {
        const copy = dict.experience.roles[role.id];
        return (
          /* Empty string rather than the boolean: Astro renders `false` as
             data-current="false", which [data-current] would still match. */
          <li class="card role reveal-item" data-current={role.current ? '' : undefined}>
            <div class="role-head">
              <span class="role-mark" aria-hidden="true">{role.company.charAt(0)}</span>

              <div class="min-w-0">
                <h3 class="role-company">{role.company}</h3>
                <p class="role-title">{copy.role}</p>
              </div>

              <p class="role-period">{role.period}</p>
            </div>

            <ul class="role-points">
              {copy.bullets.map((bullet) => (
                <li>
                  <span class="role-check" aria-hidden="true">
                    <Check />
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>
</Section>
