---
import { Check } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  One wide tile per role, in two columns: who and when on the left, what on the
  right. Side by side the two roles came out 100px apart in height, because
  one has three points and the other two, and a stacked tile with its bullets
  across the full measure ran to 150 characters a line - so each tile is as tall
  as its own content and its bullets sit at a readable width.

  Employment is a sequence, and the rail joining the initials is what says so:
  one line from the first initial to the last, through the tiles and the gaps
  between them, which fills with the accent as the page scrolls past it. The
  role he holds now takes the accent on its initial and on its period, which
  is the one place the accent marks a fact rather than a link; the period also
  carries a pulsing dot, so "2024 -" reads as running rather than cut off.

  A tile paints over whatever the tile above it draws, so the rail cannot be
  one element: each tile draws its own stretch - in from the tile above, across
  the gap, to its initial, and out from its initial to its own bottom edge -
  and the first has no way in and the last no way out. See the Experience
  block in home.css.
*/}
<Section id="experience" label={dict.experience.label} tone={tone}>
  <ol class="role-list">
    {
      site.experience.map((role, index) => {
        const copy = dict.experience.roles[role.id];
        return (
          /* Empty string rather than the boolean: Astro renders `false` as
             data-current="false", which [data-current] would still match. */
          <li class="card role" data-current={role.current ? '' : undefined}>
            {index > 0 && <span class="role-rail role-rail-in" aria-hidden="true" />}
            {index < site.experience.length - 1 && (
              <span class="role-rail role-rail-out" aria-hidden="true" />
            )}
            <div class="role-head">
              <span class="role-mark" aria-hidden="true">{role.company.charAt(0)}</span>

              <div class="min-w-0">
                <h3 class="role-company">{role.company}</h3>
                <p class="role-title">{copy.role}</p>
              </div>

              <p class="role-period">{role.period}</p>
            </div>

            <ul class="role-points">
              {copy.bullets.map((bullet) => (
                <li>
                  <span class="role-check" aria-hidden="true">
                    <Check />
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>
</Section>
