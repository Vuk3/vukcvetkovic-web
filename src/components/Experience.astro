---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  The heaviest section on the page, and the only one besides Projects that takes
  a full-contrast rule across the column rather than hanging its label in the
  margin.

  The period leads each entry and carries the largest type in the section, up to
  34px. Employment is genuinely a sequence, so the years are the structure - and
  they are also why nothing on this page is numbered 01 / 02 / 03. A date is a
  better index than a counter.

  Hovering an entry fills the rule that closes it with the accent, from the left.
  It is the section's only hover state and it moves nothing.
*/}
<Section id="experience" label={dict.experience.label} width="timeline" tone={tone} head="rule">
  <ol>
    {
      site.experience.map((role) => {
        const copy = dict.experience.roles[role.id];
        return (
          <li class="entry reveal-item">
            {/* Empty string rather than the boolean: Astro renders `false` as
                data-current="false", which [data-current] would still match. */}
            <p class="entry-period" data-current={role.current ? '' : undefined}>
              {role.period}
            </p>
            <div>
              <h3 class="entry-title">{role.company}</h3>
              <p class="entry-role">{copy.role}</p>
              <ul class="bullets measure mt-3 space-y-2">
                {copy.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
