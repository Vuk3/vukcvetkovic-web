---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
---

{/*
  The period leads each entry rather than being appended to the company after a
  middle dot. Employment is genuinely a sequence, so the dates are the structure
  and earn a column of their own — which also retires the hairline spine, since
  the column of years already draws that line.
*/}
<Section id="experience" label={dict.experience.label}>
  <ol class="space-y-10">
    {
      site.experience.map((role) => {
        const copy = dict.experience.roles[role.id];
        return (
          <li class="sm:grid sm:grid-cols-[6.5rem_1fr] sm:gap-x-6">
            <p
              class:list={[
                'display pt-0.5 text-[13px]',
                role.current ? 'text-accent' : 'text-muted',
              ]}
            >
              {role.period}
            </p>
            <div class="mt-1 sm:mt-0">
              <h3 class="display text-[1.0625rem]">{role.company}</h3>
              <p class="text-[13px] text-muted">{copy.role}</p>
              <ul class="mt-3 max-w-[34rem] space-y-2">
                {copy.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
