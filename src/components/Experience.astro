---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

{/*
  The period leads each entry rather than being appended to the company after a
  middle dot. Employment is genuinely a sequence, so the dates are the structure
  and earn a column of their own — which also retires the hairline spine, since
  the column of years already draws that line.
*/}
<Section id="experience" label={dict.experience.label} tone={tone}>
  <ol class="space-y-8">
    {
      site.experience.map((role) => {
        const copy = dict.experience.roles[role.id];
        return (
          <li class="sm:grid sm:grid-cols-[5rem_1fr] sm:gap-x-5">
            <p
              class:list={[
                'display pt-0.5 text-[15px]',
                role.current ? 'text-accent' : 'text-muted',
              ]}
            >
              {role.period}
            </p>
            <div class="mt-1 sm:mt-0">
              <h3 class="display text-[1.25rem]">{role.company}</h3>
              <p class="text-[15px] text-muted">{copy.role}</p>
              <ul class="measure mt-2 space-y-1.5">
                {copy.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
