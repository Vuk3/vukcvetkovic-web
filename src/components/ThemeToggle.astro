---
import { Moon, Sun } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
---

<button
  type="button"
  data-theme-toggle
  aria-label={dict.nav.themeToggle}
  class="inline-flex size-7 items-center justify-center text-muted transition-colors duration-150 hover:text-fg"
>
  <Sun class="size-4 dark:hidden" aria-hidden="true" />
  <Moon class="hidden size-4 dark:block" aria-hidden="true" />
</button>

<script>
  // The class is already set by the inline script in <head>; this only flips it.
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      /* Storage unavailable; the choice just will not persist. */
    }
  });
</script>
