---
import { Moon, Sun } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
---

{/* Both icons stay in the DOM and cross-rotate; `hidden` cannot be transitioned. */}
<button
  type="button"
  data-theme-toggle
  aria-label={dict.nav.themeToggle}
  class="head-btn relative"
>
  <Sun
    class="absolute size-4 rotate-0 opacity-100 transition-[opacity,rotate] duration-200 dark:-rotate-90 dark:opacity-0"
    aria-hidden="true"
  />
  <Moon
    class="absolute size-4 rotate-90 opacity-0 transition-[opacity,rotate] duration-200 dark:rotate-0 dark:opacity-100"
    aria-hidden="true"
  />
</button>

<script>
  // The class is already set by the inline script in <head>; this only flips it,
  // and points the browser's bar at the chosen theme's colour (see the
  // theme-color tags in Base.astro).
  const flip = () => {
    const isDark = document.documentElement.classList.toggle('dark');
    const chosen = isDark ? 'dark' : 'light';
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[data-scheme]')) {
      meta.media = meta.dataset.scheme === chosen ? 'all' : 'not all';
    }
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      /* Storage unavailable; the choice just will not persist. */
    }
  };

  // The new theme spreads over the page as a circle from the button: a view
  // transition whose new picture is clipped to a circle growing from the
  // button's centre to the farthest corner. The rules are `theme-flip` in
  // global.css, and they read the three lengths written here. Without view
  // transitions, or with less motion asked for, the theme simply changes.
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', (event) => {
    const root = document.documentElement;
    if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      flip();
      return;
    }
    const { left, top, width, height } = (event.currentTarget as HTMLElement).getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    root.style.setProperty('--flip-x', `${x}px`);
    root.style.setProperty('--flip-y', `${y}px`);
    root.style.setProperty('--flip-r', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
    root.dataset.themeFlip = '';
    document.startViewTransition(flip).finished.finally(() => delete root.dataset.themeFlip);
  });
</script>
