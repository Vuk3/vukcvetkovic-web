---
/**
 * The stack as a diagram: the layers a request crosses, and what they all run
 * on underneath.
 *
 *   Frontend ◀──▶ Backend ◀──▶ Data
 *                    ▲
 *                    ▼
 *             Cloud & DevOps
 *
 * Every line goes both ways, because the answer comes back the way the
 * request went: a packet runs out from Frontend to Data and Cloud and back
 * home again, on a loop.
 *
 * Backend is the ink tile, the strongest object in the drawing, for the reason
 * the core of a request diagram is: every line touches it, and it is the work.
 *
 * One markup, two arrangements, picked by the stage's own width: the row
 * above, and below it a column - Frontend over Backend, which forks into Data
 * and Cloud side by side. Every group and every line is placed by grid area,
 * so the groups keep site.ts's order in the markup (Backend first, which is
 * also the order a screen reader gets) whatever the drawing does.
 *
 * The lines are the request diagram's: 2px borders with clip-path heads, each
 * its own size container so a packet crosses it with `100cqi` and nothing is
 * measured. See the Skills block in home.css.
 */
import { AppWindow, Cloud, Database, Server } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import MarkTile from './MarkTile.astro';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

type GroupId = keyof typeof dict.skills.groups;

/* One outline per group, beside its name. A Record so a new group without an
   icon is a type error rather than a gap. */
const icons: Record<GroupId, typeof Server> = {
  backend: Server,
  frontend: AppWindow,
  data: Database,
  cloud: Cloud,
};

/* The three lines. Each joins Backend to one group, and is named by it. */
const links: GroupId[] = ['frontend', 'data', 'cloud'];
---

<Section id="skills" label={dict.skills.label} tone={tone}>
  <div class="card skills-stage">
    <div class="skills-grid">
      {
        site.skillGroups.map((group) => {
          const Icon = icons[group.id];
          return (
            <div class:list={['card skill-group', { panel: group.id === 'backend' }]} data-group={group.id}>
              <p class="tile-label">
                <span class="tile-icon">
                  <Icon aria-hidden="true" />
                </span>
                <span class="skill-group-name">{dict.skills.groups[group.id].name}</span>
              </p>

              <ul class="skill-marks">
                {group.items.map((item) => (
                  <MarkTile as="li" name={item} />
                ))}
              </ul>
            </div>
          );
        })
      }

      {
        links.map((link) => (
          <span class="skill-link" data-link={link} aria-hidden="true">
            <span class="skill-head" />
            <span class="skill-head skill-head-back" />
            <span class="skill-pk" />
            <span class="skill-pk skill-pk-back" />
          </span>
        ))
      }
    </div>
  </div>
</Section>
