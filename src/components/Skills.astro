---
/**
 * The stack, grouped, as a bento of tiles with every technology a mark tile.
 *
 * ⚠️ The groups are uneven - Backend has five entries and the other three two
 * each - and that is the trap every earlier version of this section fell into.
 * A grid of equal cards stretches to the tallest, so Data's two chips sat over
 * 200 points of nothing; rows of chips inside one card left 80% of three rows
 * empty. So the widths follow the counts instead: Backend takes two units of
 * five and leads with NestJS at full width over a two-by-two, the other three
 * take one unit each with their two marks stacked, and the grid stretches the
 * rows so every tile is exactly full. See `.skills-grid` in home.css.
 */
import { AppWindow, Cloud, Database, Server } from '@lucide/astro';
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import MarkTile from './MarkTile.astro';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

type GroupId = keyof typeof dict.skills.groups;

/* One outline per group, beside its name. A Record so a new group without an
   icon is a type error rather than a gap. */
const icons: Record<GroupId, typeof Server> = {
  backend: Server,
  frontend: AppWindow,
  data: Database,
  cloud: Cloud,
};
---

<Section id="skills" label={dict.skills.label} tone={tone}>
  <div class="skills-grid">
    {
      site.skillGroups.map((group) => {
        const Icon = icons[group.id];
        return (
          <div class="card skill-group reveal-item" data-group={group.id}>
            <p class="tile-label">
              <span class="tile-icon">
                <Icon aria-hidden="true" />
              </span>
              <span class="skill-group-name">{dict.skills.groups[group.id].name}</span>
            </p>

            <ul class="skill-marks">
              {group.items.map((item) => (
                <MarkTile as="li" name={item} />
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</Section>
