---
/**
 * One card, one row per group: the group name on the left, its technologies
 * flowing across the row as chips.
 *
 * It was a grid of logo tiles, then rows of names flowing across, then bare
 * columns, then a card per group - and that last one is the instructive
 * failure. Cards in a grid stretch to the tallest of them, so Backend's five
 * entries set the height and Data's two came out as a box with a screen of
 * nothing under them. Rows cannot do that, so the section is now as dense as
 * what it describes.
 *
 * The same rules render the grouped stack on a project page (see
 * ProjectDetail.astro), which is why the two cannot drift apart.
 */
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);
---

<Section id="skills" label={dict.skills.label} width="wide" tone={tone}>
  <dl class="card stack-card reveal">
    {
      site.skillGroups.map((group) => (
        <div class="stack-row">
          <dt class="stack-name">{dict.skills.groups[group.id].name}</dt>
          <dd class="stack-chips">
            {group.items.map((item) => (
              <span class="chip">
                <TechIcon name={item} class="chip-icon" />
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
