---
import { FileText } from '@lucide/astro';
import { Image } from 'astro:assets';
import elfak from '../assets/elfak.webp';
import type { Lang } from '../i18n/types';
import { getDict, localizePath } from '../i18n/utils';
import { site } from '../site';
import Section, { type SectionTone } from './Section.astro';

interface Props {
  lang: Lang;
  tone?: SectionTone;
}

const { lang, tone } = Astro.props;
const dict = getDict(lang);

// Displayed size in CSS pixels. 1x, 2x and 3x are emitted from the 597px source.
const crestSize = 64;
---

{/*
  Two tiles side by side: the crest large, the degree in the display voice, the
  school, and the years, then the degree's thesis across the foot of the tile -
  both are projects on the site, so each is its title and tagline, and a link to
  its write-up. The shorter rhythm keeps it the quietest block on the page, so
  it does not compete with Projects.
*/}
<Section id="education" label={dict.education.label} tone={tone} space="lite">
  <ol class="edu-grid">
    {
      site.education.map((degree) => {
        const copy = dict.education.degrees[degree.id];
        const thesis = site.projects.find((project) => project.id === degree.thesis);
        if (!thesis) throw new Error(`${degree.id}: no project "${degree.thesis}" for its thesis.`);
        const thesisCopy = dict.projects.items[thesis.id];
        return (
          <li class="card edu reveal-item">
            {/*
              Decorative, so the alt is empty: the school is named in the line
              directly beside it and a screen reader announcing the crest as
              well would just read the same thing twice.

              The crest is navy on transparent, which disappears against the
              dark theme, so it sits on its own white disc. The artwork is a
              circle already, so the disc reads as part of the seal rather than
              as a plate someone put behind it.
            */}
            <Image
              src={elfak}
              alt=""
              width={crestSize}
              densities={[1, 2, 3]}
              loading="lazy"
              class="edu-crest"
            />

            <div class="edu-text">
              <h3 class="edu-degree">{copy.degree}</h3>
              <p class="edu-school">{copy.school}</p>
              <p class="tag mt-4">{degree.period}</p>
            </div>

            <a href={localizePath(`/projects/${thesis.slug}/`, lang)} class="edu-thesis">
              <span class="tile-label">
                <span class="tile-icon">
                  <FileText aria-hidden="true" />
                </span>
                {copy.thesis}
              </span>
              <span class="edu-thesis-title">{thesisCopy.title}</span>
              <span class="edu-thesis-line">{thesisCopy.tagline}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</Section>
