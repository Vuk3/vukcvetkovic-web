---
import type { Lang } from '../i18n/types';
import { getDict } from '../i18n/utils';
import { site } from '../site';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
---

{/* Period in the left column, as in Skills and Contact, so this reads as a
    quieter block than the Experience timeline directly above it. */}
<Section id="education" label={dict.education.label}>
  <ol class="space-y-5">
    {
      site.education.map((degree) => (
        <li class="sm:flex sm:gap-6">
          <p class="text-[13px] text-muted sm:w-32 sm:shrink-0 sm:pt-1">{degree.period}</p>
          <div class="mt-1 sm:mt-0">
            <h3 class="font-heading text-base font-medium">
              {dict.education.degrees[degree.id].degree}
            </h3>
            <p class="mt-0.5 text-[13px] text-muted">{degree.school}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
