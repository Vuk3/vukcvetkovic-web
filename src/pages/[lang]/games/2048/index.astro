---
import Game2048 from '../../../../components/Game2048.astro';
import { prefixedLocales } from '../../../../i18n/types';
import { getDict, resolveLang } from '../../../../i18n/utils';
import Base from '../../../../layouts/Base.astro';
import { site } from '../../../../site';

export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({ params: { lang } }));
}

const lang = resolveLang(Astro.params.lang);
const dict = getDict(lang);

const title = `${site.games.twentyFortyEight.name} - ${site.name}`;
---

<Base lang={lang} title={title} description={dict.games.items.twentyFortyEight.metaDescription}>
  <Game2048 lang={lang} />
</Base>
