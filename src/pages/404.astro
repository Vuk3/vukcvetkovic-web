---
import NotFound from '../components/NotFound.astro';
import Base from '../layouts/Base.astro';
import { defaultLocale } from '../i18n/types';
import { getDict } from '../i18n/utils';

/*
 * The English 404, at /404.html.
 *
 * Cloudflare serves the *nearest* 404.html walking up from the requested path
 * (`not_found_handling: "404-page"` in wrangler.jsonc), so this one answers
 * every unmatched path that is not under a locale prefix, and the sibling at
 * [lang]/404.astro answers the prefixed ones.
 */
const lang = defaultLocale;
const dict = getDict(lang);
---

<Base lang={lang} title={dict.notFound.metaTitle} noindex>
  <NotFound lang={lang} />
</Base>
