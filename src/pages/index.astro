---
import Home from '../components/Home.astro';
import Base from '../layouts/Base.astro';
import { defaultLocale } from '../i18n/types';

// The default locale is unprefixed (`prefixDefaultLocale: false`), so English
// lives here and every other locale is generated by [lang]/index.astro.
const lang = defaultLocale;
---

<Base lang={lang}>
  <Home lang={lang} />
</Base>
